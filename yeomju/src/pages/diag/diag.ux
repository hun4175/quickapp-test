<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 뒤로</text>
      </div>
      <text class="title">최근 측정</text>
    </div>

    <text class="label">평균 ({{avgCount}}회)</text>
    <text class="line">{{avgLine}}</text>
    <text class="line">{{avgLine2}}</text>

    <text class="label">#1 세부</text>
    <text class="line" if="{{has1}}">{{d1a}}</text>
    <text class="line" if="{{has1}}">{{d1b}}</text>
    <text class="line" if="{{has1}}">{{d1c}}</text>
    <text class="line" if="{{has1}}">{{d1d}}</text>
    <text class="line" if="{{has1}}">{{d1e}}</text>
    <text class="line" if="{{has1}}">{{d1f}}</text>

    <text class="label">#2–5 요약</text>
    <text class="line" if="{{has2}}">{{line2}}</text>
    <text class="line" if="{{has3}}">{{line3}}</text>
    <text class="line" if="{{has4}}">{{line4}}</text>
    <text class="line" if="{{has5}}">{{line5}}</text>
    <text class="empty" if="{{!has1}}">아직 측정 없음 · 타이밍 표시 켜고 굴리기</text>

    <text class="meta">v2.5.1 · S2</text>
  </div>
</template>

<script>
import router from '@system.router'
import { loadTimingSamples } from '../../common/timing.js'
import {
  timingAverages,
  formatSampleLine,
  formatSampleDetailLines
} from '../../common/timing-core.js'

export default {
  private: {
    avgCount: 0,
    avgLine: '-',
    avgLine2: '-',
    d1a: '',
    d1b: '',
    d1c: '',
    d1d: '',
    d1e: '',
    d1f: '',
    line2: '',
    line3: '',
    line4: '',
    line5: '',
    has1: false,
    has2: false,
    has3: false,
    has4: false,
    has5: false
  },

  onShow() {
    this.reload()
  },

  onBackPress() {
    router.back()
    return true
  },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },

  async reload() {
    const samples = await loadTimingSamples()
    const avg = timingAverages(samples)
    const ms = (v) => (v >= 0 ? v + 'ms' : '-')
    this.avgCount = avg.count
    this.avgLine =
      'in→set ' +
      ms(avg.inSet) +
      ' set→start ' +
      ms(avg.setStart) +
      ' anim ' +
      ms(avg.animLen)
    this.avgLine2 =
      'evtDelay ' +
      ms(avg.evtDelay) +
      ' end→set ' +
      ms(avg.endToSet) +
      ' mv→jd ' +
      ms(avg.moveToJudge)

    if (samples[0]) {
      const d = formatSampleDetailLines(samples[0])
      this.d1a = d[0] || ''
      this.d1b = d[1] || ''
      this.d1c = d[2] || ''
      this.d1d = d[3] || ''
      this.d1e = d[4] || ''
      this.d1f = d[5] || ''
      this.has1 = true
    } else {
      this.has1 = false
    }

    this.line2 = samples[1] ? formatSampleLine(samples[1], 1) : ''
    this.line3 = samples[2] ? formatSampleLine(samples[2], 2) : ''
    this.line4 = samples[3] ? formatSampleLine(samples[3], 3) : ''
    this.line5 = samples[4] ? formatSampleLine(samples[4], 4) : ''
    this.has2 = !!samples[1]
    this.has3 = !!samples[2]
    this.has4 = !!samples[3]
    this.has5 = !!samples[4]
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #140e0a;
  padding-bottom: 24px;
}
.header {
  width: 100%;
  height: 72px;
  margin-top: 12px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.back {
  position: absolute;
  left: 12px;
  height: 48px;
  padding-left: 8px;
  padding-right: 8px;
  justify-content: center;
}
.back-text {
  font-size: 24px;
  color: #b89462;
}
.title {
  font-size: 28px;
  color: #e8c48a;
  font-weight: bold;
}
.label {
  width: 90%;
  margin-top: 14px;
  margin-bottom: 4px;
  font-size: 20px;
  color: #9a7b55;
}
.line {
  width: 92%;
  margin-top: 2px;
  font-size: 20px;
  color: #f3e2c4;
}
.empty {
  width: 90%;
  margin-top: 12px;
  font-size: 20px;
  color: #6e563c;
}
.meta {
  margin-top: 20px;
  font-size: 16px;
  color: #6e563c;
}
</style>
