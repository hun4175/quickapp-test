      <!-- 2.4.5: 사각형·줄별 absolute top(겹침 금지)·z 최상 -->
      <div class="diag-layer" if="{{diagnoseLatency}}">
        <div class="diag-box" onclick="onDiagBoxClick">
          <div class="diag-dot p1 {{diagP1On ? 'dot-on' : ''}}"></div>
          <div class="diag-dot p2 {{diagP2On ? 'dot-on' : ''}}"></div>
          <text class="diag-l0">{{diagLine0}}</text>
          <text class="diag-l1">{{diagLine1}}</text>
          <text class="diag-l2">{{diagLine2}}</text>
          <text class="diag-l3">{{diagLine3}}</text>
          <text class="diag-l4">{{diagLine4}}</text>
          <text class="diag-l5">{{diagLine5}}</text>
        </div>
      </div>
      <!-- E9: 긴누름 없을 때 설정 진입 -->
      <div class="e9-settings" if="{{e9NoLongpress}}" onclick="openSettings">
        <text class="e9-settings-text">설정</text>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount, normalizeState, formatDate } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import { pushTimingSample, TIMING_AVG_N } from '../../common/timing.js'
import { eventDeliveryDelay, deltaMs } from '../../common/timing-core.js'
import {
  CHAIN_ANIM_MS,
  CHAIN_ANIM_END_SLACK_MS,
  SWIPE_MIN_DY,
  TAP_MAX_MOVE,
  createVisibleBeads,
  animClassesForVisible,
  layoutOptsFromExps,
  classifyVerticalSwipe
} from '../../common/ring.js'

const LONGPRESS_MS = 560

export default {
  private: {
    vibrateOnBead: true,
    inputMode: 'slide',
    diagnoseLatency: false,
    singleBeadTest: false,
    visibleBeadCount: 10,
    e1Minimize: true,
    e2NoScale: false,
    e3SplitSrc: true,
    e4SkipBack: false,
    e5DirectDom: false,
    e6Solid: false,
    e7TouchStartRoll: false,
    e8ClickOnly: false,
    e9NoLongpress: false,
    e5Status: '',
    a0: '',
    l0: 372,
    t0: 177,
    s0: 160,
    r0: 80,
    z0: 0,
    src0: '/common/bead-back-160.png',
    a1: '',
    l1: 349,
    t1: -70,
    s1: 160,
    r1: 80,
    z1: 1,
    src1: '/common/bead-back-160.png',
    a2: '',
    l2: 349,
    t2: 424,
    s2: 160,
    r2: 80,
    z2: 2,
    src2: '/common/bead-back-160.png',
    a3: '',
    l3: 290,
    t3: -222,
    s3: 160,
    r3: 80,
    z3: 3,
    src3: '/common/bead-back-160.png',
    a4: '',
    l4: 290,
    t4: 576,
    s4: 160,
    r4: 80,
    z4: 4,
    src4: '/common/bead-back-160.png',
    a5: '',
    l5: 179,
    t5: -261,
    s5: 239,
    r5: 119,
    z5: 5,
    src5: '/common/bead-front-255.png',
    a6: '',
    l6: 179,
    t6: 537,
    s6: 239,
    r6: 119,
    z6: 6,
    src6: '/common/bead-front-255.png',
    a7: '',
    l7: 114,
    t7: -115,
    s7: 251,
    r7: 125,
    z7: 7,
    src7: '/common/bead-front-255.png',
    a8: '',
    l8: 114,
    t8: 379,
    s8: 251,
    r8: 125,
    z8: 8,
    src8: '/common/bead-front-255.png',
    a9: '',
    l9: 89,
    t9: 130,
    s9: 255,
    r9: 127,
    z9: 9,
    src9: '/common/bead-front-255.png',
    diagP1On: false,
    diagP2On: false,
    diagLine0: 'n=10 t0=-',
    diagLine1: 'in→set:-',
    diagLine2: 'set→start:-',
    diagLine3: 'anim:-',
    diagLine4: 'end→set:-',
    diagLine5: 'evtDelay:-'
  },

  onInit() {
    this._state = normalizeState({ todayDate: formatDate() })
    this._homeSlots = []
    this._animTimer = null
    this._sideTimer = null
    this._lpTimer = null
    this._t2Timer = null
    this._diagFlushTimer = null
    this._pendingDiag = null
    this._animating = false
    this._saveChain = Promise.resolve()
    this._saveTimer = null
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    this._gestureFired = false
    this._longPressed = false
    this._rollAlt = false
    this._t0 = 0
    this._t0Kind = ''
    this._t1 = 0
    this._t2 = 0
    this._t3 = 0
    this._tsTouchStart = 0
    this._tsFirstMove = 0
    this._tsSwipeJudge = 0
    this._tsTouchEnd = 0
    this._tsHandler = 0
    this._tsClassSet = 0
    this._evtDelay = -1
    this._timingHist = []
    this._animEndCount = 0
    this._animEndExpected = 0
    this._e5Works = null
    this._listenersBound = false
    this.hydrateGeometry()
  },

  expOpts() {
    return layoutOptsFromExps({
      e1Minimize: this.e1Minimize !== false,
      e2NoScale: !!this.e2NoScale,
      e3SplitSrc: this.e3SplitSrc !== false,
      e4SkipBack: !!this.e4SkipBack,
      singleBead: this.visibleBeadCount <= 1 || !!this.singleBeadTest
    })
  },

  hydrateGeometry() {
    const count = this.visibleBeadCount || 10
    const beads = createVisibleBeads(count, this.expOpts())
    this._homeSlots = beads.map((b) => b.homeSlot)
    for (let i = 0; i < 10; i++) {
      if (i < beads.length) {
        this['l' + i] = beads[i].left
        this['t' + i] = beads[i].top
        this['s' + i] = beads[i].size
        this['r' + i] = Math.floor(beads[i].size / 2)
        this['z' + i] = beads[i].z
        this['src' + i] = beads[i].src
      }
      this['a' + i] = ''
    }
  },

  onShow() {
    this.reload()
    this.bindAnimListeners()
  },

  onHide() {
    this.clearAllTimers()
    this._animating = false
  },

  onDestroy() {
    this.clearAllTimers()
    if (this._saveTimer) {
      clearTimeout(this._saveTimer)
      this._saveTimer = null
    }
  },

  clearAnimTimers() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
    if (this._sideTimer) {
      clearTimeout(this._sideTimer)
      this._sideTimer = null
    }
    if (this._t2Timer) {
      clearTimeout(this._t2Timer)
      this._t2Timer = null
    }
  },

  clearLpTimer() {
    if (this._lpTimer) {
      clearTimeout(this._lpTimer)
      this._lpTimer = null
    }
  },

  clearAllTimers() {
    this.clearAnimTimers()
    this.clearLpTimer()
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this._state = state
    this.vibrateOnBead = state.vibrateOnBead
    this.inputMode = state.inputMode || 'slide'
    this.diagnoseLatency = !!state.diagnoseLatency
    this.singleBeadTest = !!state.singleBeadTest
    this.visibleBeadCount = state.visibleBeadCount || 10
    this.e1Minimize = state.e1Minimize !== false
    this.e2NoScale = !!state.e2NoScale
    this.e3SplitSrc = state.e3SplitSrc !== false
    this.e4SkipBack = !!state.e4SkipBack
    this.e5DirectDom = !!state.e5DirectDom
    this.e6Solid = !!state.e6Solid
    this.e7TouchStartRoll = !!state.e7TouchStartRoll
    this.e8ClickOnly = !!state.e8ClickOnly
    this.e9NoLongpress = !!state.e9NoLongpress
    this.hydrateGeometry()
    this._animating = false
    this._listenersBound = false
    this.bindAnimListeners()
  },

  /** animationstart/end 계측용 — $element + addEventListener */
  bindAnimListeners() {
    if (this._listenersBound) return
    if (typeof this.$element !== 'function') {
      this.e5Status = 'E5:no-$element'
      return
    }
    const count = this.visibleBeadCount || 10
    let bound = 0
    for (let i = 0; i < count; i++) {
      let el = null
      try {
        el = this.$element('bw' + i)
      } catch (e) {
        el = null
      }
      if (!el || typeof el.addEventListener !== 'function') continue
      try {
        el.addEventListener('animationstart', this.onAnimStart.bind(this))
        el.addEventListener('animationend', this.onAnimEnd.bind(this))
        bound++
      } catch (e2) {
        /* ignore */
      }
    }
    this._listenersBound = bound > 0
    if (!this._listenersBound) {
      this.e5Status = this.e5Status || 'E5:no-anim-evt'
    }
  },

  /**
   * E5: Vela 공용 API는 class/style 직접 변경을 노출하지 않음.
   * attr/setAttribute 있으면 시도, 없으면 false.
   */
  applyClassDirect(i, cls) {
    if (typeof this.$element !== 'function') return false
    let el = null
    try {
      el = this.$element('bw' + i)
    } catch (e) {
      return false
    }
    if (!el) return false
    const full = ('bead-wrap ' + (cls || '')).trim()
    if (typeof el.attr === 'function') {
      try {
        el.attr({ class: full })
        return true
      } catch (e2) {
        /* fall through */
      }
    }
    if (typeof el.setAttribute === 'function') {
      try {
        el.setAttribute('class', full)
        return true
      } catch (e3) {
        /* fall through */
      }
    }
    return false
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  /** P1/P2 점만 — 텍스트 갱신 없음(핫패스) */
  markP1() {
    if (!this.diagnoseLatency) return
    this.diagP1On = !this.diagP1On
    this.diagP2On = false
  },

  markP2() {
    if (!this.diagnoseLatency) return
    this.diagP2On = !this.diagP2On
  },

  onAnimStart() {
    if (this._t2) return
    this._t2 = Date.now()
  },

  onAnimEnd() {
    this._animEndCount = (this._animEndCount || 0) + 1
    if (this._animEndExpected > 0 && this._animEndCount < this._animEndExpected) {
      return
    }
    if (!this._t3) this._t3 = Date.now()
    this.scheduleDiagFlush(true)
  },

  /** 진단 텍스트는 animationend 이후 setTimeout으로만 갱신 */
  scheduleDiagFlush(finalize) {
    if (!this.diagnoseLatency) return
    this._pendingDiag = { finalize: !!finalize }
    if (this._diagFlushTimer) return
    this._diagFlushTimer = setTimeout(() => {
      this._diagFlushTimer = null
      const p = this._pendingDiag
      this._pendingDiag = null
      if (p) this.flushDiagText(p.finalize)
    }, 0)
  },

  buildTimingSample() {
    const t0 = this._t0 || 0
    const t1 = this._tsClassSet || this._t1 || 0
    const t2 = this._t2 || 0
    const t3 = this._t3 || 0
    const inSet = deltaMs(t1, t0)
    const setStart = deltaMs(t2, t1)
    const animLen = t2 && t3 ? deltaMs(t3, t2) : deltaMs(t3, t1)
    return {
      inSet,
      setStart,
      animLen,
      t0Kind: this._t0Kind || 'judge',
      evtDelay: this._evtDelay,
      startToMove: deltaMs(this._tsFirstMove, this._tsTouchStart),
      moveToJudge: deltaMs(this._tsSwipeJudge, this._tsFirstMove),
      startToEnd: deltaMs(this._tsTouchEnd, this._tsTouchStart),
      endToSet: deltaMs(t1, this._tsTouchEnd),
      judgeToHandler: deltaMs(this._tsHandler, t0),
      handlerToSet: deltaMs(t1, this._tsHandler),
      n: this.visibleBeadCount || 10,
      e1: this.e1Minimize !== false,
      e2: !!this.e2NoScale,
      e3: this.e3SplitSrc !== false,
      e4: !!this.e4SkipBack,
      e5: !!this.e5DirectDom,
      e6: !!this.e6Solid,
      e7: !!this.e7TouchStartRoll,
      e8: !!this.e8ClickOnly,
      e9: !!this.e9NoLongpress,
      e5Status: this.e5Status || '',
      inputMode: this.inputMode || 'slide',
      at: Date.now()
    }
  },

  flushDiagText(finalize) {
    if (!this.diagnoseLatency) return
    const sample = this.buildTimingSample()
    const ms = (v) => (v >= 0 ? v + 'ms' : '-')
    this.diagLine0 =
      'n=' +
      sample.n +
      ' t0=' +
      sample.t0Kind +
      (this.e5Status ? ' ' + this.e5Status : '')
    this.diagLine1 = 'in→set:' + ms(sample.inSet)
    this.diagLine2 = 'set→start:' + ms(sample.setStart)
    this.diagLine3 = 'anim:' + ms(sample.animLen)
    if (sample.inputMode === 'touch' || sample.t0Kind === 'tap' || sample.t0Kind === 'e7') {
      this.diagLine4 = 'end→set:' + ms(sample.endToSet) + ' s→e:' + ms(sample.startToEnd)
    } else {
      this.diagLine4 = 'mv→jd:' + ms(sample.moveToJudge) + ' h→set:' + ms(sample.handlerToSet)
    }
    this.diagLine5 = 'evtDelay:' + ms(sample.evtDelay)
    if (finalize && sample.inSet >= 0) {
      this._timingHist.push(sample)
      if (this._timingHist.length > TIMING_AVG_N) this._timingHist.shift()
      pushTimingSample(sample).catch(() => false)
      const h = this._timingHist
      const avg = (key) => {
        const vals = h.map((x) => x[key]).filter((v) => v >= 0)
        if (!vals.length) return -1
        return Math.round(vals.reduce((a, b) => a + b, 0) / vals.length)
      }
      this.diagLine5 =
        'avg in/ss/an:' +
        ms(avg('inSet')) +
        '/' +
        ms(avg('setStart')) +
        '/' +
        ms(avg('animLen'))
    }
  },

  resetGestureClock() {
    this._tsTouchStart = 0
    this._tsFirstMove = 0
    this._tsSwipeJudge = 0
    this._tsTouchEnd = 0
    this._tsHandler = 0
    this._tsClassSet = 0
    this._evtDelay = -1
    this._t0 = 0
    this._t0Kind = ''
    this._t1 = 0
    this._t2 = 0
    this._t3 = 0
  },

  onTouchStart(e) {
    if (this.e8ClickOnly) {
      // E8: 롤은 click만. 터치 시작은 롱프레스/제스처 클록만.
    }
    const now = Date.now()
    const del = eventDeliveryDelay(e, now)
    this._evtDelay = del.delay
    this._tsTouchStart = now
    this._tsFirstMove = 0
    this._tsSwipeJudge = 0
    this._tsTouchEnd = 0
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._gestureFired = false
    this._longPressed = false
    this._touchX = p.x
    this._touchY = p.y
    this.markP1()
    this.clearLpTimer()
    // E7: 터치 모드에서 touchstart 즉시 +1
    if (
      !this.e8ClickOnly &&
      this.e7TouchStartRoll &&
      (this.inputMode || 'slide') === 'touch'
    ) {
      this._gestureFired = true
      this.enqueueRoll(1, 'e7')
    }
    if (!this.e9NoLongpress) {
      this._lpTimer = setTimeout(() => {
        this._lpTimer = null
        if (!this._touchActive) return
        // E7: 이미 +1 했어도 설정으로 (취소 없음)
        if (this._gestureFired && !this.e7TouchStartRoll) return
        this._longPressed = true
        this._gestureFired = true
        this._touchActive = false
        router.push({ uri: '/pages/settings' })
      }, LONGPRESS_MS)
    }
  },

  trySwipe(e) {
    if (this.e8ClickOnly) return false
    if ((this.inputMode || 'slide') === 'touch') return false
    if (!this._touchActive || this._gestureFired || this._longPressed) return false
    const p = this.touchPoint(e)
    if (!p) return false
    if (!this._tsFirstMove) this._tsFirstMove = Date.now()
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    if (Math.abs(dx) > TAP_MAX_MOVE || Math.abs(dy) > TAP_MAX_MOVE) {
      this.clearLpTimer()
    }
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (!dir) return false
    this._tsSwipeJudge = Date.now()
    this._gestureFired = true
    this.clearLpTimer()
    this.enqueueRoll(dir, 'swipe')
    return true
  },

  onTouchMove(e) {
    if (this.e8ClickOnly) return
    if (!this._touchActive) return
    if (!this._tsFirstMove) this._tsFirstMove = Date.now()
    this.trySwipe(e)
  },

  onTouchEnd(e) {
    this._tsTouchEnd = Date.now()
    if (this.e8ClickOnly) {
      this.clearLpTimer()
      this._touchActive = false
      return
    }
    if (!this._touchActive) return
    this.clearLpTimer()
    const mode = this.inputMode || 'slide'
    if (mode === 'slide') {
      this.trySwipe(e)
    } else if (!this._gestureFired && !this._longPressed) {
      // E7이 이미 굴렸으면 스킵
      const p = this.touchPoint(e)
      if (p) {
        const dx = p.x - this._touchX
        const dy = p.y - this._touchY
        if (Math.abs(dx) <= TAP_MAX_MOVE && Math.abs(dy) <= TAP_MAX_MOVE) {
          this._gestureFired = true
          this.enqueueRoll(1, 'tap')
        }
      }
    }
    this._touchActive = false
  },

  onTouchCancel() {
    this.clearLpTimer()
    this._touchActive = false
    this._gestureFired = false
  },

  /** E8: 시스템 click만으로 굴림 */
  onPageClick() {
    if (!this.e8ClickOnly) return
    if (this._longPressed) return
    this._tsTouchEnd = Date.now()
    if (!this._tsTouchStart) this._tsTouchStart = this._tsTouchEnd
    this.enqueueRoll(1, 'click')
  },

  /** E9: 긴누름 없을 때 진단 패널 탭 → 설정 */
  onDiagBoxClick() {
    if (!this.e9NoLongpress) return
    this.openSettings()
  },

  openSettings() {
    router.push({ uri: '/pages/settings' })
  },

  /**
   * t0 = 롤 결정 시각 (swipe 판정 / tap 확정 / e7 touchstart / click)
   * @param {number} dir
   * @param {string} kind
   */
  enqueueRoll(dir, kind) {
    const d = Number(dir) < 0 ? -1 : 1
    const now = Date.now()
    this._t0 = now
    this._t0Kind = kind || 'judge'
    if (kind === 'swipe' && this._tsSwipeJudge) this._t0 = this._tsSwipeJudge
    this._t1 = 0
    this._t2 = 0
    this._t3 = 0
    this._tsClassSet = 0
    this._animEndCount = 0
    if (!this._state) {
      this._state = normalizeState({ todayDate: formatDate() })
    }
    if (this._animating) {
      this.clearAnimTimers()
      this.clearAnimClasses()
      this._animating = false
    }
    this.startRoll(d)
  },

  clearAnimClasses() {
    const count = this.visibleBeadCount || 10
    const useE5 = !!this.e5DirectDom && this._e5Works !== false
    for (let i = 0; i < count; i++) {
      if (useE5) {
        const ok = this.applyClassDirect(i, '')
        if (!ok) {
          this._e5Works = false
          this.e5Status = 'E5:불가'
          this['a' + i] = ''
        }
      } else {
        this['a' + i] = ''
      }
    }
  },

  startRoll(dir) {
    this._tsHandler = Date.now()
    const d = Number(dir) < 0 ? -1 : 1
    const result = applySwipeCount(this._state, d)
    this._state = result.state
    this._animating = true
    this._rollAlt = !this._rollAlt
    const count = this.visibleBeadCount || 10
    const classes = animClassesForVisible(d, count, {
      ...this.expOpts(),
      alt: this._rollAlt
    })
    const useE5 = !!this.e5DirectDom
    let e5Ok = 0
    let e5Fail = 0
    for (let i = 0; i < count; i++) {
      const cls = classes[i] || ''
      if (useE5) {
        const ok = this.applyClassDirect(i, cls)
        if (ok) e5Ok++
        else {
          e5Fail++
          this['a' + i] = cls
        }
      } else {
        this['a' + i] = cls
      }
    }
    // 클래스 대입 직후 = t1 (핫패스 최우선 — 진단 텍스트/진동/저장 없음)
    this._tsClassSet = Date.now()
    this._t1 = this._tsClassSet
    if (useE5) {
      if (e5Ok > 0 && e5Fail === 0) {
        this._e5Works = true
        this.e5Status = 'E5:ok'
      } else if (e5Ok === 0) {
        this._e5Works = false
        this.e5Status = 'E5:불가'
      } else {
        this.e5Status = 'E5:partial'
      }
    }
    this._animEndExpected = classes.filter((c) => !!c).length || 1
    this.markP2()
    this.clearAnimTimers()
    this._t2Timer = setTimeout(() => {
      this._t2Timer = null
      if (!this._t2) this._t2 = Date.now()
    }, 0)
    const completedRound = !!result.completedRound
    const state = result.state
    // 진동·저장은 클래스 set 이후 비동기
    this._sideTimer = setTimeout(() => {
      this._sideTimer = null
      this.buzz(completedRound)
      this.queueSave(state)
    }, 0)
    this._animTimer = setTimeout(() => {
      if (!this._t3) this._t3 = Date.now()
      this.finishRoll()
      this.scheduleDiagFlush(true)
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  },

  finishRoll() {
    this.clearAnimClasses()
    this._animating = false
  },

  queueSave(state) {
    if (this._saveTimer) clearTimeout(this._saveTimer)
    this._saveTimer = setTimeout(() => {
      this._saveTimer = null
      this._saveChain = this._saveChain
        .then(() => saveState(state))
        .catch(() => false)
    }, 280)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) vibrator.vibrate({ mode: 'short' })
    if (completedRound) vibrator.vibrate({ mode: 'long' })
  }
}
</script>

