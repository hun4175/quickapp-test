<template>
  <!--
    2.4.0: 시각=2.3.1 유지. 입력 슬라이드/터치. 애니 모드·디버그 제거.
    핫패스: 클래스 먼저 → 저장/진동 나중. 진행 중 입력은 즉시 홈스냅 후 재시작.
  -->
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd"
    ontouchcancel="onTouchCancel"
    onlongpress="onLongPress"
  >
    <stack class="stage">
      <div class="ring-mover">
        <div
          class="bead-wrap {{$item.animClass}}"
          for="{{chainBeads}}"
          style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px; z-index: {{$item.z}};"
        >
          <image
            class="bead-img"
            src="{{$item.src}}"
            style="width: {{$item.size}}px; height: {{$item.size}}px;"
          ></image>
        </div>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  CHAIN_ANIM_MS,
  CHAIN_ANIM_END_SLACK_MS,
  SWIPE_MIN_DY,
  TAP_MAX_MOVE,
  createChainBeads,
  snapBeadsHome,
  withRollClasses,
  classifyVerticalSwipe
} from '../../common/ring.js'

const MAX_PENDING = 2

export default {
  private: {
    vibrateOnBead: true,
    inputMode: 'slide',
    chainBeads: []
  },

  onInit() {
    this._state = null
    this._animTimer = null
    this._sideTimer = null
    this._animating = false
    this._saveChain = Promise.resolve()
    this._saveTimer = null
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    this._gestureFired = false
    this._longPressed = false
    this._rollAlt = false
    this.chainBeads = createChainBeads()
  },

  onShow() {
    this.reload()
  },

  onHide() {
    this.clearAnimTimers()
    this._animating = false
  },

  onDestroy() {
    this.clearAnimTimers()
    if (this._saveTimer) {
      clearTimeout(this._saveTimer)
      this._saveTimer = null
    }
  },

  clearAnimTimers() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
    if (this._sideTimer) {
      clearTimeout(this._sideTimer)
      this._sideTimer = null
    }
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this._state = state
    this.vibrateOnBead = state.vibrateOnBead
    this.inputMode = state.inputMode || 'slide'
    this.chainBeads = createChainBeads()
    this._animating = false
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._gestureFired = false
    this._longPressed = false
    this._touchX = p.x
    this._touchY = p.y
  },

  /**
   * 슬라이드 모드만. 임계 SWIPE_MIN_DY 에서 즉시 굴림.
   * 터치 모드에서는 슬라이드 무시(탭만 — 오동작 방지).
   */
  trySwipe(e) {
    if ((this.inputMode || 'slide') === 'touch') return false
    if (!this._touchActive || this._gestureFired || this._longPressed) return false
    const p = this.touchPoint(e)
    if (!p) return false
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (!dir) return false
    this._gestureFired = true
    this.enqueueRoll(dir)
    return true
  },

  onTouchMove(e) {
    if (!this._touchActive) return
    this.trySwipe(e)
  },

  onTouchEnd(e) {
    if (!this._touchActive) return
    const mode = this.inputMode || 'slide'
    if (mode === 'slide') {
      this.trySwipe(e)
    } else if (!this._gestureFired && !this._longPressed) {
      // 터치 모드: 탭 = 한 칸 앞. 롱프레스 대기 없이 touchend에서 즉시.
      const p = this.touchPoint(e)
      if (p) {
        const dx = p.x - this._touchX
        const dy = p.y - this._touchY
        if (Math.abs(dx) <= TAP_MAX_MOVE && Math.abs(dy) <= TAP_MAX_MOVE) {
          this._gestureFired = true
          this.enqueueRoll(1)
        }
      }
    }
    this._touchActive = false
  },

  onTouchCancel() {
    this._touchActive = false
    this._gestureFired = false
  },

  onLongPress() {
    this._longPressed = true
    this._gestureFired = true
    router.push({ uri: '/pages/settings' })
  },

  enqueueRoll(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    if (!this._state) {
      this.reload().then(() => this.enqueueRoll(d))
      return
    }
    // 진행 중이면 즉시 홈 스냅 후 새 애니 (큐 대기 제거)
    if (this._animating) {
      this.clearAnimTimers()
      this.chainBeads = snapBeadsHome(this.chainBeads)
      this._animating = false
    }
    this.startRoll(d)
  },

  /**
   * 핫패스: 애니 클래스 setData를 최우선·단독.
   * 카운트 저장·진동은 다음 틱(같은 렌더에 섞지 않음).
   */
  startRoll(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    const result = applySwipeCount(this._state, d)
    this._state = result.state
    this._animating = true
    this._rollAlt = !this._rollAlt
    // 1) 클래스만 — 버퍼↔버퍼는 '' 유지
    this.chainBeads = withRollClasses(this.chainBeads, d, { alt: this._rollAlt })
    this.clearAnimTimers()
    const completedRound = !!result.completedRound
    const state = result.state
    this._sideTimer = setTimeout(() => {
      this._sideTimer = null
      this.buzz(completedRound)
      this.queueSave(state)
    }, 0)
    this._animTimer = setTimeout(() => {
      this.finishRoll()
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  },

  finishRoll() {
    this.chainBeads = snapBeadsHome(this.chainBeads)
    this._animating = false
  },

  queueSave(state) {
    if (this._saveTimer) clearTimeout(this._saveTimer)
    this._saveTimer = setTimeout(() => {
      this._saveTimer = null
      this._saveChain = this._saveChain
        .then(() => saveState(state))
        .catch(() => false)
    }, 280)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) vibrator.vibrate({ mode: 'short' })
    if (completedRound) vibrator.vibrate({ mode: 'long' })
  }
}
</script>

