<template>
  <!--
    2.4.1 진단: 시각=2.3.1. 정적 10노드·animClass만 갱신.
    커스텀 롱프레스(onlongpress 제거). P1/P2 진단 점.
  -->
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd"
    ontouchcancel="onTouchCancel"
  >
    <stack class="stage">
      <div class="ring-mover">
        <div
          class="bead-wrap {{a0}}"
          style="left: {{l0}}px; top: {{t0}}px; width: {{s0}}px; height: {{s0}}px; z-index: {{z0}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s0}}px; height: {{s0}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a1}}"
          style="left: {{l1}}px; top: {{t1}}px; width: {{s1}}px; height: {{s1}}px; z-index: {{z1}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s1}}px; height: {{s1}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a2}}"
          style="left: {{l2}}px; top: {{t2}}px; width: {{s2}}px; height: {{s2}}px; z-index: {{z2}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s2}}px; height: {{s2}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a3}}"
          style="left: {{l3}}px; top: {{t3}}px; width: {{s3}}px; height: {{s3}}px; z-index: {{z3}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s3}}px; height: {{s3}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a4}}"
          style="left: {{l4}}px; top: {{t4}}px; width: {{s4}}px; height: {{s4}}px; z-index: {{z4}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s4}}px; height: {{s4}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a5}}"
          style="left: {{l5}}px; top: {{t5}}px; width: {{s5}}px; height: {{s5}}px; z-index: {{z5}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s5}}px; height: {{s5}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a6}}"
          style="left: {{l6}}px; top: {{t6}}px; width: {{s6}}px; height: {{s6}}px; z-index: {{z6}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s6}}px; height: {{s6}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a7}}"
          style="left: {{l7}}px; top: {{t7}}px; width: {{s7}}px; height: {{s7}}px; z-index: {{z7}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s7}}px; height: {{s7}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a8}}"
          style="left: {{l8}}px; top: {{t8}}px; width: {{s8}}px; height: {{s8}}px; z-index: {{z8}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s8}}px; height: {{s8}}px;"
          ></image>
        </div>
        <div
          class="bead-wrap {{a9}}"
          style="left: {{l9}}px; top: {{t9}}px; width: {{s9}}px; height: {{s9}}px; z-index: {{z9}};"
        >
          <image
            class="bead-img"
            src="{{beadSrc}}"
            style="width: {{s9}}px; height: {{s9}}px;"
          ></image>
        </div>
      </div>
      <div class="diag-layer" if="{{diagnoseLatency}}">
        <div class="diag-dot p1 {{diagP1On ? 'dot-on' : ''}}"></div>
        <div class="diag-dot p2 {{diagP2On ? 'dot-on' : ''}}"></div>
        <text class="diag-text">{{diagText}}</text>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount, normalizeState, formatDate } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  CHAIN_ANIM_MS,
  CHAIN_ANIM_END_SLACK_MS,
  SWIPE_MIN_DY,
  TAP_MAX_MOVE,
  BEAD_SRC,
  createChainBeads,
  animClassesForDrawOrder,
  classifyVerticalSwipe
} from '../../common/ring.js'

/** 시스템 onlongpress 대신 자체 타이머 — touchend 지연 방지 */
const LONGPRESS_MS = 560

export default {
  private: {
    vibrateOnBead: true,
    inputMode: 'slide',
    diagnoseLatency: false,
    singleBeadTest: false,
    beadSrc: '/common/bead-wood-v3.png',
    a0: '',
    l0: 351,
    t0: 156,
    s0: 203,
    z0: 0,
    a1: '',
    l1: 324,
    t1: -95,
    s1: 210,
    z1: 1,
    a2: '',
    l2: 324,
    t2: 399,
    s2: 210,
    z2: 2,
    a3: '',
    l3: 258,
    t3: -254,
    s3: 224,
    z3: 3,
    a4: '',
    l4: 258,
    t4: 544,
    s4: 224,
    z4: 4,
    a5: '',
    l5: 179,
    t5: -261,
    s5: 239,
    z5: 5,
    a6: '',
    l6: 179,
    t6: 537,
    s6: 239,
    z6: 6,
    a7: '',
    l7: 114,
    t7: -115,
    s7: 251,
    z7: 7,
    a8: '',
    l8: 114,
    t8: 379,
    s8: 251,
    z8: 8,
    a9: '',
    l9: 89,
    t9: 130,
    s9: 255,
    z9: 9,
    diagP1On: false,
    diagP2On: false,
    diagText: 'P1:- P2:-'
  },

  onInit() {
    this._state = normalizeState({ todayDate: formatDate() })
    this._homeSlots = [5,4,6,3,7,2,8,1,9,0]
    this._animTimer = null
    this._sideTimer = null
    this._lpTimer = null
    this._animating = false
    this._saveChain = Promise.resolve()
    this._saveTimer = null
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    this._gestureFired = false
    this._longPressed = false
    this._rollAlt = false
    this._t0 = 0
    this.beadSrc = BEAD_SRC
    this.hydrateGeometry()
  },

  hydrateGeometry() {
    const beads = createChainBeads()
    this._homeSlots = beads.map((b) => b.homeSlot)
    for (let i = 0; i < beads.length; i++) {
      this['l' + i] = beads[i].left
      this['t' + i] = beads[i].top
      this['s' + i] = beads[i].size
      this['z' + i] = beads[i].z
      this['a' + i] = ''
    }
  },

  onShow() {
    this.reload()
  },

  onHide() {
    this.clearAllTimers()
    this._animating = false
  },

  onDestroy() {
    this.clearAllTimers()
    if (this._saveTimer) {
      clearTimeout(this._saveTimer)
      this._saveTimer = null
    }
  },

  clearAnimTimers() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
    if (this._sideTimer) {
      clearTimeout(this._sideTimer)
      this._sideTimer = null
    }
  },

  clearLpTimer() {
    if (this._lpTimer) {
      clearTimeout(this._lpTimer)
      this._lpTimer = null
    }
  },

  clearAllTimers() {
    this.clearAnimTimers()
    this.clearLpTimer()
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this._state = state
    this.vibrateOnBead = state.vibrateOnBead
    this.inputMode = state.inputMode || 'slide'
    this.diagnoseLatency = !!state.diagnoseLatency
    this.singleBeadTest = !!state.singleBeadTest
    this.hydrateGeometry()
    this._animating = false
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  /** P1: 이벤트 전달 확인 — 단색 div만, 이미지 없음 */
  markP1() {
    if (!this.diagnoseLatency) return
    this._t0 = Date.now()
    this.diagP1On = !this.diagP1On
    this.diagP2On = false
    this.diagText = 'P1:0 P2:-'
  },

  markP2() {
    if (!this.diagnoseLatency) return
    const dt = this._t0 ? Date.now() - this._t0 : -1
    this.diagP2On = !this.diagP2On
    this.diagText = 'P1:0 P2:' + dt + 'ms'
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._gestureFired = false
    this._longPressed = false
    this._touchX = p.x
    this._touchY = p.y
    this.markP1()
    this.clearLpTimer()
    this._lpTimer = setTimeout(() => {
      this._lpTimer = null
      if (!this._touchActive || this._gestureFired) return
      this._longPressed = true
      this._gestureFired = true
      this._touchActive = false
      router.push({ uri: '/pages/settings' })
    }, LONGPRESS_MS)
  },

  trySwipe(e) {
    if ((this.inputMode || 'slide') === 'touch') return false
    if (!this._touchActive || this._gestureFired || this._longPressed) return false
    const p = this.touchPoint(e)
    if (!p) return false
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    if (Math.abs(dx) > TAP_MAX_MOVE || Math.abs(dy) > TAP_MAX_MOVE) {
      this.clearLpTimer()
    }
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (!dir) return false
    this._gestureFired = true
    this.clearLpTimer()
    this.enqueueRoll(dir)
    return true
  },

  onTouchMove(e) {
    if (!this._touchActive) return
    this.trySwipe(e)
  },

  onTouchEnd(e) {
    if (!this._touchActive) return
    this.clearLpTimer()
    const mode = this.inputMode || 'slide'
    if (mode === 'slide') {
      this.trySwipe(e)
    } else if (!this._gestureFired && !this._longPressed) {
      const p = this.touchPoint(e)
      if (p) {
        const dx = p.x - this._touchX
        const dy = p.y - this._touchY
        if (Math.abs(dx) <= TAP_MAX_MOVE && Math.abs(dy) <= TAP_MAX_MOVE) {
          this._gestureFired = true
          this.enqueueRoll(1)
        }
      }
    }
    this._touchActive = false
  },

  onTouchCancel() {
    this.clearLpTimer()
    this._touchActive = false
    this._gestureFired = false
  },

  enqueueRoll(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    if (!this._state) {
      this._state = normalizeState({ todayDate: formatDate() })
    }
    if (this._animating) {
      this.clearAnimTimers()
      this.clearAnimClasses()
      this._animating = false
    }
    this.startRoll(d)
  },

  clearAnimClasses() {
    this.a0 = ''
    this.a1 = ''
    this.a2 = ''
    this.a3 = ''
    this.a4 = ''
    this.a5 = ''
    this.a6 = ''
    this.a7 = ''
    this.a8 = ''
    this.a9 = ''
  },

  /**
   * animClass만 개별 필드 갱신 (src/left/top/size 불변).
   * for+전체 배열 교체·이미지 재바인딩 회피.
   */
  startRoll(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    const result = applySwipeCount(this._state, d)
    this._state = result.state
    this._animating = true
    this._rollAlt = !this._rollAlt
    const classes = animClassesForDrawOrder(d, {
      alt: this._rollAlt,
      singleBead: !!this.singleBeadTest
    })
    for (let i = 0; i < 10; i++) {
      this['a' + i] = classes[i] || ''
    }
    this.markP2()
    this.clearAnimTimers()
    const completedRound = !!result.completedRound
    const state = result.state
    this._sideTimer = setTimeout(() => {
      this._sideTimer = null
      this.buzz(completedRound)
      this.queueSave(state)
    }, 0)
    this._animTimer = setTimeout(() => {
      this.finishRoll()
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  },

  finishRoll() {
    this.clearAnimClasses()
    this._animating = false
  },

  queueSave(state) {
    if (this._saveTimer) clearTimeout(this._saveTimer)
    this._saveTimer = setTimeout(() => {
      this._saveTimer = null
      this._saveChain = this._saveChain
        .then(() => saveState(state))
        .catch(() => false)
    }, 280)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) vibrator.vibrate({ mode: 'short' })
    if (completedRound) vibrator.vibrate({ mode: 'long' })
  }
}
</script>

<style>
