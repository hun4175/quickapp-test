<template>
  <!--
    큰 염주 고리: 화면 전체 stack. 알은 일부가 화면 밖으로 잘림.
    z-index 미문서화 → depth 오름차순으로 stack 에 넣어 앞 알이 위에 그려짐.
    HUD(오늘/카운트/설정)는 반투명 배경으로 구슬 위에 올림.
  -->
  <div class="page" onswipe="onSwipe">
    <stack class="stage">
      <stack class="ring {{rolling ? 'ring-roll' : ''}}" onclick="onTap">
        <div
          class="bead-wrap"
          for="{{ringBeads}}"
          style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px; opacity: {{$item.opacity}};"
        >
          <image
            class="bead-img"
            src="{{$item.src}}"
            style="width: {{$item.size}}px; height: {{$item.size}}px;"
          ></image>
        </div>
        <image
          class="focus-arc"
          src="/common/focus-arc.png"
          style="left: {{markerLeft}}px; top: {{markerTop}}px; width: {{markerSize}}px; height: {{markerSize}}px;"
        ></image>
        <text class="plus" show="{{showPlus}}">+1</text>
      </stack>

      <div class="hud-top">
        <div class="hud-chip">
          <text class="today">오늘 {{todayTotal}}</text>
        </div>
      </div>

      <div class="hud-bottom">
        <div class="hud-panel" onclick="onTap">
          <text class="count">{{bead}} / {{beadsPerRound}}</text>
          <text class="rounds">바퀴 {{rounds}}</text>
        </div>
        <div class="btn" onclick="goSettings">
          <text class="btn-text">설정</text>
        </div>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { advanceBead } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  VISIBLE_BEADS,
  DEFAULT_RING,
  phaseFromBead,
  layoutRing,
  layoutFocusMarker
} from '../../common/ring.js'

export default {
  private: {
    bead: 0,
    rounds: 0,
    beadsPerRound: 108,
    todayTotal: 0,
    vibrateOnBead: true,
    rolling: false,
    showPlus: false,
    ringBeads: [],
    markerLeft: 0,
    markerTop: 0,
    markerSize: 72,
    pendingTicks: 0
  },

  onInit() {
    this._state = null
    this._animTimer = null
    this._draining = false
    this._saveChain = Promise.resolve()
    this.placeMarker()
    this.refreshRing(0)
  },

  onShow() {
    this.reload()
  },

  onDestroy() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this.applyState(state)
  },

  applyState(state) {
    this._state = state
    this.bead = state.bead
    this.rounds = state.rounds
    this.beadsPerRound = state.beadsPerRound
    this.todayTotal = state.todayTotal
    this.vibrateOnBead = state.vibrateOnBead
    this.refreshRing(phaseFromBead(state.bead, VISIBLE_BEADS))
  },

  placeMarker() {
    const m = layoutFocusMarker(DEFAULT_RING)
    this.markerLeft = m.left
    this.markerTop = m.top
    this.markerSize = m.size
  },

  refreshRing(phaseIndex) {
    this.ringBeads = layoutRing({
      ...DEFAULT_RING,
      visible: VISIBLE_BEADS,
      phaseIndex
    })
  },

  onTap() {
    this.enqueueTick()
  },

  onSwipe(e) {
    if (!e || !e.direction) return
    if (e.direction === 'up' || e.direction === 'left') {
      this.enqueueTick()
    }
  },

  enqueueTick() {
    this.pendingTicks += 1
    if (!this._state) {
      this.reload().then(() => this.drainTicks())
      return
    }
    this.drainTicks()
  },

  drainTicks() {
    if (this._draining) return
    this._draining = true
    try {
      while (this.pendingTicks > 0 && this._state) {
        this.pendingTicks -= 1
        this.advanceOnce()
      }
    } finally {
      this._draining = false
      if (this.pendingTicks > 0 && this._state) {
        this.drainTicks()
      }
    }
  },

  advanceOnce() {
    const result = advanceBead(this._state)
    this.applyState(result.state)
    this.queueSave(result.state)
    this.playFeedback(result.completedRound)
  },

  queueSave(state) {
    this._saveChain = this._saveChain
      .then(() => saveState(state))
      .catch(() => false)
  },

  playFeedback(completedRound) {
    if (this.vibrateOnBead) {
      vibrator.vibrate({ mode: 'short' })
    }
    if (completedRound) {
      vibrator.vibrate({ mode: 'long' })
    }

    this.rolling = false
    this.showPlus = false
    setTimeout(() => {
      this.rolling = true
      this.showPlus = true
    }, 16)

    if (this._animTimer) clearTimeout(this._animTimer)
    this._animTimer = setTimeout(() => {
      this.rolling = false
      this.showPlus = false
    }, 240)
  },

  goSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #0c0a08;
}

.stage {
  width: 432px;
  height: 514px;
}

.ring {
  width: 432px;
  height: 514px;
}

.ring-roll {
  animation-name: ringStep;
  animation-duration: 240ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.bead-wrap {
  position: absolute;
}

.bead-img {
  position: absolute;
  left: 0px;
  top: 0px;
}

.focus-arc {
  position: absolute;
}

.plus {
  position: absolute;
  left: 96px;
  top: 200px;
  font-size: 32px;
  font-weight: bold;
  color: #f5d9a8;
  animation-name: plusUp;
  animation-duration: 240ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.hud-top {
  width: 432px;
  height: 64px;
  margin-top: 10px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.hud-chip {
  padding-left: 18px;
  padding-right: 18px;
  height: 40px;
  border-radius: 20px;
  background-color: #1a1410;
  opacity: 0.88;
  justify-content: center;
  align-items: center;
}

.today {
  font-size: 22px;
  color: #e8c48a;
}

.hud-bottom {
  width: 432px;
  position: absolute;
  bottom: 12px;
  left: 0px;
  flex-direction: column;
  align-items: center;
}

.hud-panel {
  width: 280px;
  padding-top: 8px;
  padding-bottom: 8px;
  border-radius: 18px;
  background-color: #1a1410;
  opacity: 0.9;
  flex-direction: column;
  align-items: center;
}

.count {
  font-size: 36px;
  font-weight: bold;
  color: #f3e2c4;
}

.rounds {
  margin-top: 2px;
  font-size: 20px;
  color: #b89462;
}

.btn {
  width: 140px;
  height: 48px;
  margin-top: 10px;
  border-radius: 24px;
  background-color: #2a1c12;
  opacity: 0.95;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #6b4a2a;
}

.btn-text {
  font-size: 22px;
  color: #e8c48a;
}

@keyframes ringStep {
  0% {
    transform: translateY(0px) rotate(0deg);
  }
  45% {
    transform: translateY(18px) rotate(-3deg);
  }
  100% {
    transform: translateY(0px) rotate(0deg);
  }
}

@keyframes plusUp {
  0% {
    transform: translateY(0px);
    opacity: 1;
  }
  100% {
    transform: translateY(-32px);
    opacity: 0;
  }
}
</style>
