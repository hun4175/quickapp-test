  100% { transform: translate(-35px, -212px) scale(1.101); }
}
.roll-next-5 {
  animation-name: kf-next-5;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-5 {
  animation-name: kf-prev-5;
