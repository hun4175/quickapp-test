<template>
  <!--
    1.6.0: 구슬별 슬롯 i→i±1 @keyframes (translate+scale).
    HUD 숨김(카운트·저장은 유지). 설정은 길게 누르기(longpress).
  -->
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchend="onTouchEnd"
    onlongpress="onLongPress"
  >
    <stack class="stage">
      <stack class="ring">
        <div
          class="bead-wrap {{$item.animClass}}"
          for="{{chainBeads}}"
          style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px;"
        >
          <image
            class="bead-img"
            src="{{$item.src}}"
            style="width: {{$item.size}}px; height: {{$item.size}}px;"
          ></image>
        </div>
      </stack>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  VIRTUAL_BEADS,
  CHAIN_ANIM_MS,
  SWIPE_MIN_DY,
  phaseFromBead,
  stepPhase,
  createChainBeads,
  advanceChainBeads,
  rollClassForSlot,
  classifyVerticalSwipe
} from '../../common/ring.js'

export default {
  private: {
    bead: 0,
    rounds: 0,
    beadsPerRound: 108,
    todayTotal: 0,
    vibrateOnBead: true,
    chainBeads: [],
    displayPhase: 0
  },

  onInit() {
    this._state = null
    this._animTimer = null
    this._draining = false
    this._animating = false
    this._saveChain = Promise.resolve()
    this._pendingDirs = []
    this._animQueue = []
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    this.chainBeads = createChainBeads()
  },

  onShow() {
    this.reload()
  },

  onDestroy() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this.applyState(state, true)
  },

  applyState(state, snapVisual) {
    this._state = state
    this.bead = state.bead
    this.rounds = state.rounds
    this.beadsPerRound = state.beadsPerRound
    this.todayTotal = state.todayTotal
    this.vibrateOnBead = state.vibrateOnBead
    if (snapVisual) {
      this.displayPhase = phaseFromBead(state.bead, VIRTUAL_BEADS)
    }
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._touchX = p.x
    this._touchY = p.y
  },

  onTouchEnd(e) {
    if (!this._touchActive) return
    this._touchActive = false
    const p = this.touchPoint(e)
    if (!p) return
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (dir) this.enqueueSwipe(dir)
  },

  /** 설정 진입: 화면을 가리는 버튼 없이 longpress */
  onLongPress() {
    router.push({ uri: '/pages/settings' })
  },

  enqueueSwipe(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    this._pendingDirs.push(d)
    if (!this._state) {
      this.reload().then(() => this.drainSwipes())
      return
    }
    this.drainSwipes()
  },

  drainSwipes() {
    if (this._draining) return
    this._draining = true
    try {
      while (this._pendingDirs.length > 0 && this._state) {
        const dir = this._pendingDirs.shift()
        this.advanceOnce(dir)
      }
    } finally {
      this._draining = false
      if (this._pendingDirs.length > 0 && this._state) {
        this.drainSwipes()
      }
    }
  },

  advanceOnce(dir) {
    const result = applySwipeCount(this._state, dir)
    this.applyState(result.state, false)
    this.queueSave(result.state)
    this.buzz(result.completedRound)
    this._animQueue.push(dir)
    this.ensureChainAnim()
  },

  queueSave(state) {
    this._saveChain = this._saveChain
      .then(() => saveState(state))
      .catch(() => false)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) {
      vibrator.vibrate({ mode: 'short' })
    }
    if (completedRound) {
      vibrator.vibrate({ mode: 'long' })
    }
  },

  /**
   * 구슬별 roll-next-i / roll-prev-i 클래스만 토글.
   * 종료 시 슬롯 인덱스·left/top/size 한 번 스냅 (프레임 루프 없음).
   */
  ensureChainAnim() {
    if (this._animating) return
    if (!this._animQueue.length) return

    const dir = this._animQueue.shift()
    this._animating = true
    this.chainBeads = this.chainBeads.map((b) => ({
      ...b,
      animClass: rollClassForSlot(b.slot, dir)
    }))

    if (this._animTimer) clearTimeout(this._animTimer)
    this._animTimer = setTimeout(() => {
      this.displayPhase = stepPhase(this.displayPhase, dir, VIRTUAL_BEADS)
      this.chainBeads = advanceChainBeads(this.chainBeads, dir)
      this._animating = false
      this.ensureChainAnim()
    }, CHAIN_ANIM_MS)
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #0c0a08;
}

.stage {
  width: 432px;
  height: 514px;
}

.ring {
  width: 432px;
  height: 514px;
}

.bead-wrap {
  position: absolute;
  transform-origin: center center;
}

.bead-img {
  position: absolute;
  left: 0px;
  top: 0px;
}

/* CHAIN_KF_BEGIN */
.roll-next-0 {
  animation-name: kf-next-0;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-0 {
  animation-name: kf-prev-0;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-0 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(9px, -115px) scale(0.988); }
  100% { transform: translate(35px, -212px) scale(0.958); }
}
@keyframes kf-prev-0 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(9px, 115px) scale(0.988); }
  100% { transform: translate(35px, 212px) scale(0.958); }
}
.roll-next-1 {
  animation-name: kf-next-1;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-1 {
  animation-name: kf-prev-1;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-1 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(38px, -65px) scale(0.948); }
  100% { transform: translate(83px, -88px) scale(0.887); }
}
@keyframes kf-prev-1 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-26px, 97px) scale(1.03); }
  100% { transform: translate(-35px, 212px) scale(1.043); }
}
.roll-next-2 {
  animation-name: kf-next-2;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-2 {
  animation-name: kf-prev-2;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-2 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(45px, 23px) scale(0.926); }
  100% { transform: translate(83px, 88px) scale(0.858); }
}
@keyframes kf-prev-2 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-45px, 23px) scale(1.069); }
  100% { transform: translate(-83px, 88px) scale(1.127); }
}
.roll-next-3 {
  animation-name: kf-next-3;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-3 {
  animation-name: kf-prev-3;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-3 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(26px, 97px) scale(0.937); }
  100% { transform: translate(35px, 212px) scale(0.909); }
}
@keyframes kf-prev-3 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-38px, -65px) scale(1.08); }
  100% { transform: translate(-83px, -88px) scale(1.166); }
}
.roll-next-4 {
  animation-name: kf-next-4;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-4 {
  animation-name: kf-prev-4;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-4 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-9px, 115px) scale(1.031); }
  100% { transform: translate(-35px, 212px) scale(1.101); }
}
@keyframes kf-prev-4 {
  0% { transform: translate(0px, 0px) scale(1); }
