<template>
  <!--
    1.5.0: 고정 슬롯 + 레인 transform 한 번.
    슬롯 left/top/size 는 onInit 이후 재바인딩하지 않음.
    탭 카운트 없음. touch Δy 임계값. 양방향 스와이프.
  -->
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchend="onTouchEnd"
  >
    <stack class="stage">
      <stack class="ring">
        <!-- 뒤열 먼저(아래 레이어) — stack 문서순서 -->
        <stack class="lane {{backRollClass}}">
          <div
            class="bead-wrap"
            for="{{backSlots}}"
            style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px;"
          >
            <image
              class="bead-img"
              src="{{$item.src}}"
              style="width: {{$item.size}}px; height: {{$item.size}}px;"
            ></image>
          </div>
        </stack>
        <stack class="lane {{frontRollClass}}">
          <div
            class="bead-wrap"
            for="{{frontSlots}}"
            style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px;"
          >
            <image
              class="bead-img"
              src="{{$item.src}}"
              style="width: {{$item.size}}px; height: {{$item.size}}px;"
            ></image>
          </div>
        </stack>
        <text class="plus" show="{{showPlus}}">+1</text>
      </stack>

      <div class="hud-top">
        <div class="hud-chip">
          <text class="today">오늘 {{todayTotal}}</text>
        </div>
      </div>

      <div class="hud-bottom">
        <div class="hud-panel">
          <text class="count">{{bead}} / {{beadsPerRound}}</text>
          <text class="rounds">바퀴 {{rounds}}</text>
          <text class="hint">위아래로 밀어서 굴리기</text>
        </div>
        <div class="btn" onclick="goSettings">
          <text class="btn-text">설정</text>
        </div>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  VIRTUAL_BEADS,
  CHAIN_ANIM_MS,
  SWIPE_MIN_DY,
  phaseFromBead,
  stepPhase,
  layoutFixedSlots,
  rollClassForLane,
  classifyVerticalSwipe
} from '../../common/ring.js'

export default {
  private: {
    bead: 0,
    rounds: 0,
    beadsPerRound: 108,
    todayTotal: 0,
    vibrateOnBead: true,
    showPlus: false,
    frontSlots: [],
    backSlots: [],
    frontRollClass: '',
    backRollClass: '',
    displayPhase: 0
  },

  onInit() {
    this._state = null
    this._animTimer = null
    this._draining = false
    this._animating = false
    this._saveChain = Promise.resolve()
    this._pendingDirs = []
    this._animQueue = []
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    // 고정 슬롯 — 이후 left/top/size 재바인딩 없음
    const slots = layoutFixedSlots()
    this.frontSlots = slots.front
    this.backSlots = slots.back
  },

  onShow() {
    this.reload()
  },

  onDestroy() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this.applyState(state, true)
  },

  applyState(state, snapVisual) {
    this._state = state
    this.bead = state.bead
    this.rounds = state.rounds
    this.beadsPerRound = state.beadsPerRound
    this.todayTotal = state.todayTotal
    this.vibrateOnBead = state.vibrateOnBead
    if (snapVisual) {
      this.displayPhase = phaseFromBead(state.bead, VIRTUAL_BEADS)
    }
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._touchX = p.x
    this._touchY = p.y
  },

  onTouchEnd(e) {
    if (!this._touchActive) return
    this._touchActive = false
    const p = this.touchPoint(e)
    if (!p) return
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (dir) this.enqueueSwipe(dir)
  },

  enqueueSwipe(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    this._pendingDirs.push(d)
    if (!this._state) {
      this.reload().then(() => this.drainSwipes())
      return
    }
    this.drainSwipes()
  },

  drainSwipes() {
    if (this._draining) return
    this._draining = true
    try {
      while (this._pendingDirs.length > 0 && this._state) {
        const dir = this._pendingDirs.shift()
        this.advanceOnce(dir)
      }
    } finally {
      this._draining = false
      if (this._pendingDirs.length > 0 && this._state) {
        this.drainSwipes()
      }
    }
  },

  advanceOnce(dir) {
    const result = applySwipeCount(this._state, dir)
    this.applyState(result.state, false)
    this.queueSave(result.state)
    this.buzz(result.completedRound)
    this._animQueue.push(dir)
    this.ensureChainAnim()
  },

  queueSave(state) {
    this._saveChain = this._saveChain
      .then(() => saveState(state))
      .catch(() => false)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) {
      vibrator.vibrate({ mode: 'short' })
    }
    if (completedRound) {
      vibrator.vibrate({ mode: 'long' })
    }
  },

  /**
   * 슬롯 좌표는 그대로 두고, 레인에 transform 클래스만 붙였다 뗌.
   */
  ensureChainAnim() {
    if (this._animating) return
    if (!this._animQueue.length) return

    const dir = this._animQueue.shift()
    this._animating = true
    this.showPlus = true
    this.frontRollClass = rollClassForLane('front', dir)
    this.backRollClass = rollClassForLane('back', dir)

    if (this._animTimer) clearTimeout(this._animTimer)
    this._animTimer = setTimeout(() => {
      this.displayPhase = stepPhase(this.displayPhase, dir, VIRTUAL_BEADS)
      this.frontRollClass = ''
      this.backRollClass = ''
      this.showPlus = false
      this._animating = false
      this.ensureChainAnim()
    }, CHAIN_ANIM_MS)
  },

  goSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #0c0a08;
}

.stage {
  width: 432px;
  height: 514px;
}

.ring {
  width: 432px;
  height: 514px;
}

.lane {
  width: 432px;
  height: 514px;
}

.lane-roll-up {
  animation-name: laneUp;
  animation-duration: 160ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.lane-roll-down {
  animation-name: laneDown;
  animation-duration: 160ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.bead-wrap {
  position: absolute;
}

.bead-img {
  position: absolute;
  left: 0px;
  top: 0px;
}

.plus {
  position: absolute;
  left: 200px;
  top: 120px;
  font-size: 28px;
  font-weight: bold;
  color: #f5d9a8;
  animation-name: plusUp;
  animation-duration: 160ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.hud-top {
  width: 432px;
  height: 48px;
  margin-top: 8px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.hud-chip {
  padding-left: 16px;
  padding-right: 16px;
  height: 36px;
  border-radius: 8px;
  background-color: #1a1410;
  justify-content: center;
  align-items: center;
}

.today {
  font-size: 20px;
  color: #e8c48a;
}

.hud-bottom {
  width: 432px;
  position: absolute;
  bottom: 10px;
  left: 0px;
  flex-direction: column;
  align-items: center;
}

.hud-panel {
  width: 280px;
  padding-top: 6px;
  padding-bottom: 6px;
  border-radius: 8px;
  background-color: #1a1410;
  flex-direction: column;
  align-items: center;
}

.count {
  font-size: 32px;
  font-weight: bold;
  color: #f3e2c4;
}

.rounds {
  margin-top: 2px;
  font-size: 18px;
  color: #b89462;
}

.hint {
  margin-top: 4px;
  font-size: 16px;
  color: #9a7a52;
}

.btn {
  width: 140px;
  height: 44px;
  margin-top: 8px;
  border-radius: 8px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #6b4a2a;
}

.btn-text {
  font-size: 20px;
  color: #e8c48a;
}

/* chainStepY ≈ 150 — 레인 단위 단순 translate (오버슈트 없음) */
@keyframes laneUp {
  0% {
    transform: translateY(0px);
  }
  100% {
    transform: translateY(-150px);
  }
}

@keyframes laneDown {
  0% {
    transform: translateY(0px);
  }
  100% {
    transform: translateY(150px);
  }
}

@keyframes plusUp {
  0% {
    transform: translateY(0px);
    opacity: 1;
  }
  100% {
    transform: translateY(-28px);
    opacity: 0;
  }
}
</style>
