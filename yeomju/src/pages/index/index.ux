  animation-fill-mode: forwards;
}
@keyframes kf-next-5 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-38px, 65px) scale(1.08); }
  100% { transform: translate(-83px, 88px) scale(1.166); }
}
@keyframes kf-prev-5 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(26px, -97px) scale(0.937); }
  100% { transform: translate(35px, -212px) scale(0.909); }
}
.roll-next-6 {
  animation-name: kf-next-6;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-6 {
  animation-name: kf-prev-6;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-6 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(-45px, -23px) scale(1.069); }
  100% { transform: translate(-83px, -88px) scale(1.127); }
}
@keyframes kf-prev-6 {
  0% { transform: translate(0px, 0px) scale(1); }
  50% { transform: translate(45px, -23px) scale(0.926); }
  100% { transform: translate(83px, -88px) scale(0.858); }
}
.roll-next-7 {
  animation-name: kf-next-7;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-7 {
  animation-name: kf-prev-7;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
