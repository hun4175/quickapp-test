            style="width: {{s9}}px; height: {{s9}}px; border-radius: {{r9}}px;"
          ></div>
        </div>
      </div>
      <div class="diag-layer" if="{{diagnoseLatency}}">
        <div class="diag-dot p1 {{diagP1On ? 'dot-on' : ''}}"></div>
        <div class="diag-dot p2 {{diagP2On ? 'dot-on' : ''}}"></div>
        <text class="diag-text">{{diagText}}</text>
        <text class="diag-line">{{diagLine1}}</text>
        <text class="diag-line2">{{diagLine2}}</text>
        <text class="diag-line3">{{diagLine3}}</text>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount, normalizeState, formatDate } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  CHAIN_ANIM_MS,
  CHAIN_ANIM_END_SLACK_MS,
  SWIPE_MIN_DY,
  TAP_MAX_MOVE,
  createVisibleBeads,
  animClassesForVisible,
  layoutOptsFromExps,
  classifyVerticalSwipe
} from '../../common/ring.js'

const LONGPRESS_MS = 560
const TIMING_AVG_N = 5

export default {
  private: {
    vibrateOnBead: true,
    inputMode: 'slide',
    diagnoseLatency: false,
    singleBeadTest: false,
    visibleBeadCount: 10,
    e1Minimize: true,
    e2NoScale: false,
    e3SplitSrc: true,
    e4SkipBack: false,
    e5DirectDom: false,
    e6Solid: false,
    e5Status: '',
    a0: '',
    l0: 372,
    t0: 177,
    s0: 160,
    r0: 80,
    z0: 0,
    src0: '/common/bead-back-160.png',
    a1: '',
    l1: 349,
    t1: -70,
    s1: 160,
    r1: 80,
    z1: 1,
    src1: '/common/bead-back-160.png',
    a2: '',
    l2: 349,
    t2: 424,
    s2: 160,
    r2: 80,
    z2: 2,
    src2: '/common/bead-back-160.png',
    a3: '',
    l3: 290,
    t3: -222,
    s3: 160,
    r3: 80,
    z3: 3,
    src3: '/common/bead-back-160.png',
    a4: '',
    l4: 290,
    t4: 576,
    s4: 160,
    r4: 80,
    z4: 4,
    src4: '/common/bead-back-160.png',
    a5: '',
    l5: 179,
    t5: -261,
    s5: 239,
    r5: 119,
    z5: 5,
    src5: '/common/bead-front-255.png',
    a6: '',
    l6: 179,
    t6: 537,
    s6: 239,
    r6: 119,
    z6: 6,
    src6: '/common/bead-front-255.png',
    a7: '',
    l7: 114,
    t7: -115,
    s7: 251,
    r7: 125,
    z7: 7,
    src7: '/common/bead-front-255.png',
    a8: '',
    l8: 114,
    t8: 379,
    s8: 251,
    r8: 125,
    z8: 8,
    src8: '/common/bead-front-255.png',
    a9: '',
    l9: 89,
    t9: 130,
    s9: 255,
    r9: 127,
    z9: 9,
    src9: '/common/bead-front-255.png',
    diagP1On: false,
    diagP2On: false,
    diagText: 'P1:- P2:-',
    diagLine1: 'in→set:-',
    diagLine2: 'set→start:-',
    diagLine3: 'anim:- avg:-'
  },

  onInit() {
    this._state = normalizeState({ todayDate: formatDate() })
    this._homeSlots = []
    this._animTimer = null
    this._sideTimer = null
    this._lpTimer = null
    this._t2Timer = null
    this._animating = false
    this._saveChain = Promise.resolve()
    this._saveTimer = null
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    this._gestureFired = false
    this._longPressed = false
    this._rollAlt = false
    this._t0 = 0
    this._t1 = 0
    this._t2 = 0
    this._t3 = 0
    this._timingHist = []
    this._animEndCount = 0
    this._animEndExpected = 0
    this._e5Works = null
    this._listenersBound = false
    this.hydrateGeometry()
  },

  expOpts() {
    return layoutOptsFromExps({
      e1Minimize: this.e1Minimize !== false,
      e2NoScale: !!this.e2NoScale,
      e3SplitSrc: this.e3SplitSrc !== false,
      e4SkipBack: !!this.e4SkipBack,
      singleBead: this.visibleBeadCount <= 1 || !!this.singleBeadTest
    })
  },

  hydrateGeometry() {
    const count = this.visibleBeadCount || 10
    const beads = createVisibleBeads(count, this.expOpts())
    this._homeSlots = beads.map((b) => b.homeSlot)
    for (let i = 0; i < 10; i++) {
      if (i < beads.length) {
        this['l' + i] = beads[i].left
        this['t' + i] = beads[i].top
        this['s' + i] = beads[i].size
        this['r' + i] = Math.floor(beads[i].size / 2)
        this['z' + i] = beads[i].z
        this['src' + i] = beads[i].src
      }
      this['a' + i] = ''
    }
  },

  onShow() {
    this.reload()
    this.bindAnimListeners()
  },

  onHide() {
    this.clearAllTimers()
    this._animating = false
  },

  onDestroy() {
    this.clearAllTimers()
    if (this._saveTimer) {
      clearTimeout(this._saveTimer)
      this._saveTimer = null
    }
  },

  clearAnimTimers() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
    if (this._sideTimer) {
      clearTimeout(this._sideTimer)
      this._sideTimer = null
    }
    if (this._t2Timer) {
      clearTimeout(this._t2Timer)
      this._t2Timer = null
    }
  },

  clearLpTimer() {
    if (this._lpTimer) {
      clearTimeout(this._lpTimer)
      this._lpTimer = null
    }
  },

  clearAllTimers() {
    this.clearAnimTimers()
    this.clearLpTimer()
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this._state = state
    this.vibrateOnBead = state.vibrateOnBead
    this.inputMode = state.inputMode || 'slide'
    this.diagnoseLatency = !!state.diagnoseLatency
    this.singleBeadTest = !!state.singleBeadTest
    this.visibleBeadCount = state.visibleBeadCount || 10
    this.e1Minimize = state.e1Minimize !== false
    this.e2NoScale = !!state.e2NoScale
    this.e3SplitSrc = state.e3SplitSrc !== false
    this.e4SkipBack = !!state.e4SkipBack
    this.e5DirectDom = !!state.e5DirectDom
    this.e6Solid = !!state.e6Solid
    this.hydrateGeometry()
    this._animating = false
    this._listenersBound = false
    this.bindAnimListeners()
  },

  /** animationstart/end 계측용 — $element + addEventListener */
  bindAnimListeners() {
    if (this._listenersBound) return
    if (typeof this.$element !== 'function') {
      this.e5Status = 'E5:no-$element'
      return
    }
    const count = this.visibleBeadCount || 10
    let bound = 0
    for (let i = 0; i < count; i++) {
      let el = null
      try {
        el = this.$element('bw' + i)
      } catch (e) {
        el = null
      }
      if (!el || typeof el.addEventListener !== 'function') continue
      try {
        el.addEventListener('animationstart', this.onAnimStart.bind(this))
        el.addEventListener('animationend', this.onAnimEnd.bind(this))
        bound++
      } catch (e2) {
        /* ignore */
      }
    }
    this._listenersBound = bound > 0
    if (!this._listenersBound) {
      this.e5Status = this.e5Status || 'E5:no-anim-evt'
    }
  },

  /**
   * E5: Vela 공용 API는 class/style 직접 변경을 노출하지 않음.
   * attr/setAttribute 있으면 시도, 없으면 false.
   */
  applyClassDirect(i, cls) {
    if (typeof this.$element !== 'function') return false
    let el = null
    try {
      el = this.$element('bw' + i)
    } catch (e) {
      return false
    }
    if (!el) return false
    const full = ('bead-wrap ' + (cls || '')).trim()
    if (typeof el.attr === 'function') {
      try {
        el.attr({ class: full })
        return true
      } catch (e2) {
        /* fall through */
      }
    }
    if (typeof el.setAttribute === 'function') {
      try {
        el.setAttribute('class', full)
        return true
      } catch (e3) {
        /* fall through */
      }
    }
    return false
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  markP1() {
    if (!this.diagnoseLatency) return
    this.diagP1On = !this.diagP1On
    this.diagP2On = false
  },

  markP2() {
    if (!this.diagnoseLatency) return
    this.diagP2On = !this.diagP2On
  },

  onAnimStart() {
    if (this._t2) return
    this._t2 = Date.now()
    this.refreshDiagTiming()
  },

  onAnimEnd() {
    this._animEndCount = (this._animEndCount || 0) + 1
    if (this._animEndExpected > 0 && this._animEndCount < this._animEndExpected) {
      return
    }
    if (!this._t3) {
      this._t3 = Date.now()
      this.refreshDiagTiming(true)
    }
  },

  refreshDiagTiming(finalize) {
    if (!this.diagnoseLatency) return
    const t0 = this._t0 || 0
    const t1 = this._t1 || 0
    const t2 = this._t2 || 0
    const t3 = this._t3 || 0
    const inSet = t0 && t1 ? t1 - t0 : -1
    const setStart = t1 && t2 ? t2 - t1 : -1
    const animLen = t2 && t3 ? t3 - t2 : t1 && t3 ? t3 - t1 : -1
    const e5 = this.e5Status ? ' ' + this.e5Status : ''
    this.diagText = 'n=' + (this.visibleBeadCount || 10) + e5
    this.diagLine1 = 'in→set:' + (inSet >= 0 ? inSet + 'ms' : '-')
    this.diagLine2 = 'set→start:' + (setStart >= 0 ? setStart + 'ms' : '-')
    if (finalize && inSet >= 0) {
      this._timingHist.push({ inSet, setStart, animLen })
      if (this._timingHist.length > TIMING_AVG_N) this._timingHist.shift()
      const h = this._timingHist
      const avg = (key) => {
        const vals = h.map((x) => x[key]).filter((v) => v >= 0)
        if (!vals.length) return -1
        return Math.round(vals.reduce((a, b) => a + b, 0) / vals.length)
      }
      const a1 = avg('inSet')
      const a2 = avg('setStart')
      const a3 = avg('animLen')
      this.diagLine3 =
        'anim:' +
        (animLen >= 0 ? animLen + 'ms' : '-') +
        ' avg:' +
        (a1 >= 0 ? a1 : '-') +
        '/' +
        (a2 >= 0 ? a2 : '-') +
        '/' +
        (a3 >= 0 ? a3 : '-')
    } else {
      this.diagLine3 =
        'anim:' + (animLen >= 0 ? animLen + 'ms' : '-') + ' avg:-'
    }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._gestureFired = false
    this._longPressed = false
    this._touchX = p.x
    this._touchY = p.y
    this.markP1()
    this.clearLpTimer()
    this._lpTimer = setTimeout(() => {
      this._lpTimer = null
      if (!this._touchActive || this._gestureFired) return
      this._longPressed = true
      this._gestureFired = true
      this._touchActive = false
      router.push({ uri: '/pages/settings' })
    }, LONGPRESS_MS)
  },

  trySwipe(e) {
    if ((this.inputMode || 'slide') === 'touch') return false
    if (!this._touchActive || this._gestureFired || this._longPressed) return false
    const p = this.touchPoint(e)
    if (!p) return false
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    if (Math.abs(dx) > TAP_MAX_MOVE || Math.abs(dy) > TAP_MAX_MOVE) {
      this.clearLpTimer()
    }
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (!dir) return false
    this._gestureFired = true
    this.clearLpTimer()
    this.enqueueRoll(dir)
    return true
  },

  onTouchMove(e) {
    if (!this._touchActive) return
    this.trySwipe(e)
  },

  onTouchEnd(e) {
    if (!this._touchActive) return
    this.clearLpTimer()
    const mode = this.inputMode || 'slide'
    if (mode === 'slide') {
      this.trySwipe(e)
    } else if (!this._gestureFired && !this._longPressed) {
      const p = this.touchPoint(e)
      if (p) {
        const dx = p.x - this._touchX
        const dy = p.y - this._touchY
        if (Math.abs(dx) <= TAP_MAX_MOVE && Math.abs(dy) <= TAP_MAX_MOVE) {
          this._gestureFired = true
          this.enqueueRoll(1)
        }
      }
    }
    this._touchActive = false
  },

  onTouchCancel() {
    this.clearLpTimer()
    this._touchActive = false
    this._gestureFired = false
  },

  enqueueRoll(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    // t0 = 스와이프 판정 또는 탭 확정 시점
    this._t0 = Date.now()
    this._t1 = 0
    this._t2 = 0
    this._t3 = 0
    this._animEndCount = 0
    if (!this._state) {
      this._state = normalizeState({ todayDate: formatDate() })
    }
    if (this._animating) {
      this.clearAnimTimers()
      this.clearAnimClasses()
      this._animating = false
    }
    this.startRoll(d)
  },

  clearAnimClasses() {
    const count = this.visibleBeadCount || 10
    const useE5 = !!this.e5DirectDom && this._e5Works !== false
    for (let i = 0; i < count; i++) {
      if (useE5) {
        const ok = this.applyClassDirect(i, '')
        if (!ok) {
          this._e5Works = false
          this.e5Status = 'E5:불가'
          this['a' + i] = ''
        }
      } else {
        this['a' + i] = ''
      }
    }
  },

  startRoll(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    const result = applySwipeCount(this._state, d)
    this._state = result.state
    this._animating = true
    this._rollAlt = !this._rollAlt
    const count = this.visibleBeadCount || 10
    const classes = animClassesForVisible(d, count, {
      ...this.expOpts(),
      alt: this._rollAlt
    })
    const useE5 = !!this.e5DirectDom
    let e5Ok = 0
    let e5Fail = 0
    for (let i = 0; i < count; i++) {
      const cls = classes[i] || ''
      if (useE5) {
        const ok = this.applyClassDirect(i, cls)
        if (ok) {
          e5Ok++
          // 바인딩 갱신 생략 (비용 비교용)
        } else {
          e5Fail++
          this['a' + i] = cls
        }
      } else {
        this['a' + i] = cls
      }
    }
    if (useE5) {
      if (e5Ok > 0 && e5Fail === 0) {
        this._e5Works = true
        this.e5Status = 'E5:ok'
      } else if (e5Ok === 0) {
        this._e5Works = false
        this.e5Status = 'E5:불가'
      } else {
        this.e5Status = 'E5:partial'
      }
    }
    this._t1 = Date.now()
    this._animEndExpected = classes.filter((c) => !!c).length || 1
    this.markP2()
    this.refreshDiagTiming(false)
    this.clearAnimTimers()
    // t2 폴백: animationstart 미지원 시 setTimeout(0)
    this._t2Timer = setTimeout(() => {
      this._t2Timer = null
      if (!this._t2) {
        this._t2 = Date.now()
        this.refreshDiagTiming(false)
      }
    }, 0)
    const completedRound = !!result.completedRound
    const state = result.state
    this._sideTimer = setTimeout(() => {
      this._sideTimer = null
      this.buzz(completedRound)
      this.queueSave(state)
    }, 0)
    this._animTimer = setTimeout(() => {
      if (!this._t3) {
        this._t3 = Date.now()
        this.refreshDiagTiming(true)
      }
      this.finishRoll()
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  },

  finishRoll() {
    this.clearAnimClasses()
    this._animating = false
  },

  queueSave(state) {
    if (this._saveTimer) clearTimeout(this._saveTimer)
    this._saveTimer = setTimeout(() => {
      this._saveTimer = null
      this._saveChain = this._saveChain
        .then(() => saveState(state))
        .catch(() => false)
    }, 280)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) vibrator.vibrate({ mode: 'short' })
    if (completedRound) vibrator.vibrate({ mode: 'long' })
  }
}
</script>

