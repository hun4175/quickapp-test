<template>
  <!--
    2.0.1 안정화: 기본 Mode A(플랫 리스트=1.8 구조).
    D/E는 실험(위험). 레인 템플릿은 useLanes 일 때만.
  -->
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd"
    ontouchcancel="onTouchCancel"
    onlongpress="onLongPress"
  >
    <stack class="stage">
      <div class="ring-mover {{moverClass}}" if="{{!useLanes}}">
        <div
          class="bead-wrap {{$item.animClass}}"
          for="{{chainBeads}}"
          style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px;"
        >
          <image
            class="bead-img"
            src="{{$item.src}}"
            style="width: {{$item.size}}px; height: {{$item.size}}px;"
          ></image>
        </div>
      </div>
      <div class="ring-mover" if="{{useLanes}}">
        <div class="lane {{backLaneClass}}" style="{{backLaneStyle}}">
          <div
            class="bead-wrap {{$item.animClass}}"
            for="{{backBeads}}"
            style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px;"
          >
            <image
              class="bead-img"
              src="{{$item.src}}"
              style="width: {{$item.size}}px; height: {{$item.size}}px;"
            ></image>
          </div>
        </div>
        <div class="lane {{frontLaneClass}}" style="{{frontLaneStyle}}">
          <div
            class="bead-wrap {{$item.animClass}}"
            for="{{frontBeads}}"
            style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px;"
          >
            <image
              class="bead-img"
              src="{{$item.src}}"
              style="width: {{$item.size}}px; height: {{$item.size}}px;"
            ></image>
          </div>
        </div>
      </div>
      <div class="debug-hud" if="{{debugLatency}}">
        <text class="debug-text">터치→시작 {{debugTouchMs}}ms</text>
        <text class="debug-text">완료 {{debugAnimMs}}ms</text>
        <text class="debug-text">프레임 {{debugFrames}}</text>
      </div>
    </stack>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { applySwipeCount } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  VIRTUAL_BEADS,
  CHAIN_ANIM_MS,
  CHAIN_ANIM_END_SLACK_MS,
  SWIPE_MIN_DY,
  JS_FRAME_MS,
  BEAD_SRC,
  phaseFromBead,
  stepPhase,
  createChainBeads,
  advanceChainBeads,
  advanceChainBeadsWithAnim,
  rollClassForSlot,
  classifyVerticalSwipe,
  splitChainLanes,
  laneClassForDir,
  frontLaneShiftY,
  backLaneShiftY,
  tyStyle
} from '../../common/ring.js'

const MAX_PENDING = 2

export default {
  private: {
    bead: 0,
    rounds: 0,
    beadsPerRound: 108,
    todayTotal: 0,
    vibrateOnBead: true,
    animMode: 'A',
    useLanes: false,
    debugLatency: false,
    chainBeads: [],
    frontBeads: [],
    backBeads: [],
    displayPhase: 0,
    moverClass: '',
    frontLaneClass: '',
    backLaneClass: '',
    frontLaneStyle: '',
    backLaneStyle: '',
    debugTouchMs: '-',
    debugAnimMs: '-',
    debugFrames: '-'
  },

  onInit() {
    this._state = null
    this._animTimer = null
    this._jsTimer = null
    this._draining = false
    this._animating = false
    this._saveChain = Promise.resolve()
    this._pendingDirs = []
    this._animQueue = []
    this._touchX = 0
    this._touchY = 0
    this._touchActive = false
    this._gestureFired = false
    this._saveTimer = null
    this._gestureAt = 0
    this._animStartAt = 0
    this._jsFrames = 0
    this._jsDir = 1
    this._jsStart = 0
    this.applyBeads(createChainBeads())
  },

  applyBeads(beads) {
    const list = beads.map((b) => ({ ...b, src: BEAD_SRC }))
    this.chainBeads = list
    if (this.useLanes) {
      const lanes = splitChainLanes(list)
      this.frontBeads = lanes.frontBeads
      this.backBeads = lanes.backBeads
    } else {
      this.frontBeads = []
      this.backBeads = []
    }
  },

  setModeFlags(mode) {
    const m = mode || 'A'
    this.animMode = m
    this.useLanes = m === 'D' || m === 'E'
  },

  clearLaneMotion() {
    this.frontLaneClass = ''
    this.backLaneClass = ''
    this.frontLaneStyle = ''
    this.backLaneStyle = ''
    this.moverClass = ''
  },

  onShow() {
    this.reload()
  },

  onHide() {
    this.clearAnimTimers()
    this._animating = false
    this.clearLaneMotion()
  },

  onDestroy() {
    this.clearAnimTimers()
    if (this._saveTimer) {
      clearTimeout(this._saveTimer)
      this._saveTimer = null
    }
  },

  clearAnimTimers() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
    if (this._jsTimer) {
      clearTimeout(this._jsTimer)
      this._jsTimer = null
    }
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this.applyState(state, true)
  },

  applyState(state, snapVisual) {
    this._state = state
    this.bead = state.bead
    this.rounds = state.rounds
    this.beadsPerRound = state.beadsPerRound
    this.todayTotal = state.todayTotal
    this.vibrateOnBead = state.vibrateOnBead
    this.setModeFlags(state.animMode || 'A')
    this.debugLatency = !!state.debugLatency
    if (snapVisual) {
      this.displayPhase = phaseFromBead(state.bead, VIRTUAL_BEADS)
      this.clearLaneMotion()
      this.applyBeads(createChainBeads())
    }
  },

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    if (!p) return
    this._touchActive = true
    this._gestureFired = false
    this._touchX = p.x
    this._touchY = p.y
  },

  trySwipe(e) {
    if (!this._touchActive || this._gestureFired) return false
    const p = this.touchPoint(e)
    if (!p) return false
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    const dir = classifyVerticalSwipe(dx, dy, { minDy: SWIPE_MIN_DY })
    if (!dir) return false
    this._gestureFired = true
    this._gestureAt = Date.now()
    this.enqueueSwipe(dir)
    return true
  },

  onTouchMove(e) {
    if (!this._touchActive) return
    this.trySwipe(e)
  },

  onTouchEnd(e) {
    if (!this._touchActive) return
    this.trySwipe(e)
    this._touchActive = false
  },

  onTouchCancel() {
    this._touchActive = false
    this._gestureFired = false
  },

  onLongPress() {
    router.push({ uri: '/pages/settings' })
  },

  enqueueSwipe(dir) {
    const d = Number(dir) < 0 ? -1 : 1
    if (this._pendingDirs.length + this._animQueue.length >= MAX_PENDING) {
      return
    }
    this._pendingDirs.push(d)
    if (!this._state) {
      this.reload().then(() => this.drainSwipes())
      return
    }
    this.drainSwipes()
  },

  drainSwipes() {
    if (this._draining) return
    this._draining = true
    try {
      while (this._pendingDirs.length > 0 && this._state) {
        this.advanceOnce(this._pendingDirs.shift())
      }
    } finally {
      this._draining = false
      if (this._pendingDirs.length > 0 && this._state) this.drainSwipes()
    }
  },

  advanceOnce(dir) {
    const result = applySwipeCount(this._state, dir)
    this.applyState(result.state, false)
    if (this._animQueue.length >= MAX_PENDING) return
    this._animQueue.push({
      dir,
      completedRound: !!result.completedRound,
      state: result.state
    })
    this.ensureChainAnim()
  },

  queueSave(state) {
    if (this._saveTimer) clearTimeout(this._saveTimer)
    this._saveTimer = setTimeout(() => {
      this._saveTimer = null
      this._saveChain = this._saveChain
        .then(() => saveState(state))
        .catch(() => false)
    }, 280)
  },

  buzz(completedRound) {
    if (this.vibrateOnBead) vibrator.vibrate({ mode: 'short' })
    if (completedRound) vibrator.vibrate({ mode: 'long' })
  },

  markAnimStart() {
    this._animStartAt = Date.now()
    this._jsFrames = 0
    if (this.debugLatency && this._gestureAt) {
      this.debugTouchMs = String(this._animStartAt - this._gestureAt)
    }
  },

  markAnimEnd() {
    if (this.debugLatency && this._animStartAt) {
      this.debugAnimMs = String(Date.now() - this._animStartAt)
      this.debugFrames = String(this._jsFrames)
    }
  },

  ensureChainAnim() {
    if (this._animating) return
    if (!this._animQueue.length) return
    const mode = this.animMode || 'A'
    if (mode === 'B') return this.runModeB()
    if (mode === 'C') return this.runModeC()
    if (mode === 'D') return this.runModeD()
    if (mode === 'E') return this.runModeE()
    return this.runModeA()
  },

  runModeA() {
    const item = this._animQueue.shift()
    const dir = item.dir
    this._animating = true
    this.clearLaneMotion()
    this.applyBeads(
      this.chainBeads.map((b) => ({
        ...b,
        animClass: rollClassForSlot(b.slot, dir)
      }))
    )
    this.markAnimStart()
    this.buzz(item.completedRound)
    this.queueSave(item.state)
    this.clearAnimTimers()
    this._animTimer = setTimeout(() => {
      this.finishModeA(dir)
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  },

  finishModeA(dir) {
    this.markAnimEnd()
    this.displayPhase = stepPhase(this.displayPhase, dir, VIRTUAL_BEADS)
    const nextItem = this._animQueue.length ? this._animQueue[0] : null
    if (nextItem) {
      const nextDir = nextItem.dir
      this._animQueue.shift()
      this.applyBeads(advanceChainBeadsWithAnim(this.chainBeads, dir, nextDir))
      this.markAnimStart()
      this.buzz(nextItem.completedRound)
      this.queueSave(nextItem.state)
      this.clearAnimTimers()
      this._animTimer = setTimeout(() => {
        this.finishModeA(nextDir)
      }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
      return
    }
    this.applyBeads(advanceChainBeads(this.chainBeads, dir))
    this._animating = false
    this.ensureChainAnim()
  },

  runModeB() {
    const item = this._animQueue.shift()
    const dir = item.dir
    this._animating = true
    this.clearLaneMotion()
    this.markAnimStart()
    this.displayPhase = stepPhase(this.displayPhase, dir, VIRTUAL_BEADS)
    this.applyBeads(advanceChainBeads(this.chainBeads, dir))
    this.buzz(item.completedRound)
    this.queueSave(item.state)
    this.markAnimEnd()
    this._animating = false
    this.ensureChainAnim()
  },

  runModeC() {
    const item = this._animQueue.shift()
    const dir = item.dir
    this._animating = true
    this.clearLaneMotion()
    this.applyBeads(this.chainBeads.map((b) => ({ ...b, animClass: '' })))
    this.moverClass = Number(dir) < 0 ? 'mover-down' : 'mover-up'
    this.markAnimStart()
    this.buzz(item.completedRound)
    this.queueSave(item.state)
    this.clearAnimTimers()
    this._animTimer = setTimeout(() => {
      this.markAnimEnd()
      this.displayPhase = stepPhase(this.displayPhase, dir, VIRTUAL_BEADS)
      this.moverClass = ''
      this.applyBeads(advanceChainBeads(this.chainBeads, dir))
      this._animating = false
      this.ensureChainAnim()
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  },

  runModeD() {
    const item = this._animQueue.shift()
    const dir = item.dir
    this._animating = true
    this.clearAnimTimers()
    this.moverClass = ''
    this.frontLaneClass = ''
    this.backLaneClass = ''
    this.applyBeads(this.chainBeads.map((b) => ({ ...b, animClass: '' })))
    this._jsDir = dir
    this._jsStart = Date.now()
    this._jsFrames = 0
    this.markAnimStart()
    this.buzz(item.completedRound)
    this.queueSave(item.state)
    this.tickModeD()
  },

  tickModeD() {
    if (!this._animating) return
    this._jsFrames += 1
    const elapsed = Date.now() - this._jsStart
    const t = Math.min(1, elapsed / CHAIN_ANIM_MS)
    this.frontLaneStyle = tyStyle(Math.round(frontLaneShiftY(this._jsDir) * t))
    this.backLaneStyle = tyStyle(Math.round(backLaneShiftY(this._jsDir) * t))
    if (t >= 1) {
      this.clearAnimTimers()
      this.markAnimEnd()
      this.displayPhase = stepPhase(this.displayPhase, this._jsDir, VIRTUAL_BEADS)
      this.frontLaneStyle = ''
      this.backLaneStyle = ''
      this.applyBeads(advanceChainBeads(this.chainBeads, this._jsDir))
      this._animating = false
      this.ensureChainAnim()
      return
    }
    if (this._jsTimer) {
      clearTimeout(this._jsTimer)
      this._jsTimer = null
    }
    this._jsTimer = setTimeout(() => this.tickModeD(), JS_FRAME_MS)
  },

  runModeE() {
    const item = this._animQueue.shift()
    const dir = item.dir
    this._animating = true
    this.clearAnimTimers()
    this.moverClass = ''
    this.frontLaneStyle = ''
    this.backLaneStyle = ''
    this.applyBeads(this.chainBeads.map((b) => ({ ...b, animClass: '' })))
    this.frontLaneClass = laneClassForDir('front', dir)
    this.backLaneClass = laneClassForDir('back', dir)
    this.markAnimStart()
    this.buzz(item.completedRound)
    this.queueSave(item.state)
    this._animTimer = setTimeout(() => {
      this.markAnimEnd()
      this.displayPhase = stepPhase(this.displayPhase, dir, VIRTUAL_BEADS)
      this.frontLaneClass = ''
      this.backLaneClass = ''
      this.applyBeads(advanceChainBeads(this.chainBeads, dir))
      this._animating = false
      this.ensureChainAnim()
    }, CHAIN_ANIM_MS + CHAIN_ANIM_END_SLACK_MS)
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #0c0a08;
}
.stage {
  width: 432px;
  height: 514px;
}
.ring-mover {
  width: 432px;
  height: 514px;
  position: absolute;
  left: 0px;
  top: 0px;
}
.lane {
  width: 432px;
  height: 514px;
  position: absolute;
  left: 0px;
  top: 0px;
}
.bead-wrap {
  position: absolute;
  transform-origin: center center;
}
.bead-img {
  position: absolute;
  left: 0px;
  top: 0px;
}
.debug-hud {
  position: absolute;
  left: 8px;
  top: 8px;
  width: 220px;
  flex-direction: column;
}
.debug-text {
  font-size: 15px;
  color: #c4a574;
}
.mover-up {
  animation-name: kf-mover-up;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-mover-up {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-209px); }
}
.mover-down {
  animation-name: kf-mover-down;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-mover-down {
  0% { transform: translateY(0px); }
  100% { transform: translateY(209px); }
}
.lane-front-up {
  animation-name: kf-front-up;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-front-up {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-209px); }
}
.lane-front-down {
  animation-name: kf-front-down;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-front-down {
  0% { transform: translateY(0px); }
  100% { transform: translateY(209px); }
}
.lane-back-up {
  animation-name: kf-back-up;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-back-up {
  0% { transform: translateY(0px); }
  100% { transform: translateY(150px); }
}
.lane-back-down {
  animation-name: kf-back-down;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-back-down {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-150px); }
}
/* CHAIN_KF_BEGIN */
.roll-next-0 {
  animation-name: kf-next-0;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-0 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(12px, -132px) scale(0.985); }
  50% { transform: translate(27px, -190px) scale(0.977); }
  75% { transform: translate(34px, -210px) scale(0.974); }
  100% { transform: translate(35px, -212px) scale(0.974); }
}
.roll-prev-0 {
  animation-name: kf-prev-0;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-prev-0 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(12px, 132px) scale(0.985); }
  50% { transform: translate(27px, 190px) scale(0.977); }
  75% { transform: translate(34px, 210px) scale(0.974); }
  100% { transform: translate(35px, 212px) scale(0.974); }
}
.roll-next-1 {
  animation-name: kf-next-1;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-1 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(45px, -72px) scale(0.956); }
  50% { transform: translate(71px, -87px) scale(0.933); }
  75% { transform: translate(82px, -88px) scale(0.925); }
  100% { transform: translate(83px, -88px) scale(0.923); }
}
.roll-prev-1 {
  animation-name: kf-prev-1;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-prev-1 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(-29px, 114px) scale(1.016); }
  50% { transform: translate(-34px, 183px) scale(1.024); }
  75% { transform: translate(-35px, 208px) scale(1.027); }
  100% { transform: translate(-35px, 212px) scale(1.027); }
}
.roll-next-2 {
  animation-name: kf-next-2;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-2 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(52px, 30px) scale(0.949); }
  50% { transform: translate(75px, 68px) scale(0.923); }
  75% { transform: translate(82px, 85px) scale(0.914); }
  100% { transform: translate(83px, 88px) scale(0.912); }
}
.roll-prev-2 {
  animation-name: kf-prev-2;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-prev-2 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(-52px, 30px) scale(1.048); }
  50% { transform: translate(-75px, 68px) scale(1.073); }
  75% { transform: translate(-82px, 85px) scale(1.082); }
  100% { transform: translate(-83px, 88px) scale(1.083); }
}
.roll-next-3 {
  animation-name: kf-next-3;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-next-3 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(29px, 114px) scale(0.969); }
  50% { transform: translate(34px, 183px) scale(0.953); }
  75% { transform: translate(35px, 208px) scale(0.947); }
  100% { transform: translate(35px, 212px) scale(0.947); }
}
.roll-prev-3 {
  animation-name: kf-prev-3;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
@keyframes kf-prev-3 {
  0% { transform: translate(0px, 0px) scale(1); }
  25% { transform: translate(-45px, -72px) scale(1.056); }
  50% { transform: translate(-71px, -87px) scale(1.084); }
  75% { transform: translate(-82px, -88px) scale(1.095); }
  100% { transform: translate(-83px, -88px) scale(1.096); }
}
.roll-next-4 {
  animation-name: kf-next-4;
  animation-duration: 190ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
