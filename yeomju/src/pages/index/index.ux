}
@keyframes kf-roll-next-5 {
  0% { transform: translate(0px, 0px) scale(1); }
  100% { transform: translate(-23px, 247px) scale(1); }
}
.roll-next-5-b {
  animation-name: kf-roll-next-5;
  animation-duration: 150ms;
  animation-timing-function: linear;
  animation-delay: 0ms;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
}
.roll-prev-5 {
  animation-name: kf-roll-prev-5;
