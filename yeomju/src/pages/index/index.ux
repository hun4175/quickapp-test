<template>
  <!--
    염주 고리 UI: stack 에 타원 배치된 알 + 왼쪽 포커스 호.
    애니메이션은 공식 문서의 @keyframes + transform 만 사용
    (transition 의 transform/left/top 은 문서상 미지원).
  -->
  <div class="page" onswipe="onSwipe">
    <text class="today">오늘 {{todayTotal}}</text>

    <stack class="ring {{rolling ? 'ring-roll' : ''}}" onclick="onTap">
      <div
        class="bead-wrap"
        for="{{ringBeads}}"
        style="left: {{$item.left}}px; top: {{$item.top}}px; width: {{$item.size}}px; height: {{$item.size}}px; opacity: {{$item.opacity}};"
      >
        <image
          class="bead-img"
          src="{{$item.src}}"
          style="width: {{$item.size}}px; height: {{$item.size}}px;"
        ></image>
      </div>
      <image
        class="focus-arc"
        src="/common/focus-arc.png"
        style="left: {{markerLeft}}px; top: {{markerTop}}px; width: {{markerSize}}px; height: {{markerSize}}px;"
      ></image>
      <text class="plus" show="{{showPlus}}">+1</text>
    </stack>

    <div class="count-area" onclick="onTap">
      <text class="count">{{bead}} / {{beadsPerRound}}</text>
      <text class="rounds">바퀴 {{rounds}}</text>
    </div>

    <div class="bar">
      <div class="btn" onclick="goSettings">
        <text class="btn-text">설정</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { advanceBead } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'
import {
  VISIBLE_BEADS,
  DEFAULT_RING,
  phaseFromBead,
  layoutRing,
  layoutFocusMarker
} from '../../common/ring.js'

export default {
  private: {
    bead: 0,
    rounds: 0,
    beadsPerRound: 108,
    todayTotal: 0,
    vibrateOnBead: true,
    rolling: false,
    showPlus: false,
    ringBeads: [],
    markerLeft: 0,
    markerTop: 0,
    markerSize: 72,
    pendingTicks: 0
  },

  onInit() {
    this._state = null
    this._animTimer = null
    this._draining = false
    this._saveChain = Promise.resolve()
    this.placeMarker()
    this.refreshRing(0)
  },

  onShow() {
    this.reload()
  },

  onDestroy() {
    if (this._animTimer) {
      clearTimeout(this._animTimer)
      this._animTimer = null
    }
  },

  onBackPress() {
    return false
  },

  async reload() {
    const state = await loadState()
    this.applyState(state)
  },

  applyState(state) {
    this._state = state
    this.bead = state.bead
    this.rounds = state.rounds
    this.beadsPerRound = state.beadsPerRound
    this.todayTotal = state.todayTotal
    this.vibrateOnBead = state.vibrateOnBead
    this.refreshRing(phaseFromBead(state.bead, VISIBLE_BEADS))
  },

  placeMarker() {
    const m = layoutFocusMarker(DEFAULT_RING)
    this.markerLeft = m.left
    this.markerTop = m.top
    this.markerSize = m.size
  },

  refreshRing(phaseIndex) {
    this.ringBeads = layoutRing({
      ...DEFAULT_RING,
      visible: VISIBLE_BEADS,
      phaseIndex
    })
  },

  onTap() {
    this.enqueueTick()
  },

  onSwipe(e) {
    if (!e || !e.direction) return
    if (e.direction === 'up' || e.direction === 'left') {
      this.enqueueTick()
    }
  },

  /**
   * 빠른 연타 시 카운트 누락 방지: 탭마다 pending 을 쌓고 동기 전진.
   * storage 저장은 체인으로 직렬화하되 await 로 탭을 막지 않음.
   */
  enqueueTick() {
    this.pendingTicks += 1
    if (!this._state) {
      this.reload().then(() => this.drainTicks())
      return
    }
    this.drainTicks()
  },

  drainTicks() {
    if (this._draining) return
    this._draining = true
    try {
      while (this.pendingTicks > 0 && this._state) {
        this.pendingTicks -= 1
        this.advanceOnce()
      }
    } finally {
      this._draining = false
      if (this.pendingTicks > 0 && this._state) {
        this.drainTicks()
      }
    }
  },

  advanceOnce() {
    const result = advanceBead(this._state)
    this.applyState(result.state)
    this.queueSave(result.state)
    this.playFeedback(result.completedRound)
  },

  queueSave(state) {
    this._saveChain = this._saveChain
      .then(() => saveState(state))
      .catch(() => false)
  },

  playFeedback(completedRound) {
    if (this.vibrateOnBead) {
      vibrator.vibrate({ mode: 'short' })
    }
    if (completedRound) {
      vibrator.vibrate({ mode: 'long' })
    }

    // 키프레임을 다시 트리거하기 위해 클래스 토글
    this.rolling = false
    this.showPlus = false
    setTimeout(() => {
      this.rolling = true
      this.showPlus = true
    }, 16)

    if (this._animTimer) clearTimeout(this._animTimer)
    this._animTimer = setTimeout(() => {
      this.rolling = false
      this.showPlus = false
    }, 240)
  },

  goSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background-color: #0c0a08;
}

.today {
  margin-top: 18px;
  font-size: 22px;
  color: #9a7b55;
}

.ring {
  width: 360px;
  height: 380px;
  margin-top: 4px;
}

.ring-roll {
  animation-name: ringStep;
  animation-duration: 240ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.bead-wrap {
  position: absolute;
}

.bead-img {
  position: absolute;
  left: 0px;
  top: 0px;
}

.focus-arc {
  position: absolute;
}

.plus {
  position: absolute;
  left: 48px;
  top: 150px;
  font-size: 28px;
  font-weight: bold;
  color: #f5d9a8;
  animation-name: plusUp;
  animation-duration: 240ms;
  animation-timing-function: ease-out;
  animation-iteration-count: 1;
}

.count-area {
  margin-top: 2px;
  flex-direction: column;
  align-items: center;
}

.count {
  font-size: 40px;
  font-weight: bold;
  color: #f3e2c4;
}

.rounds {
  margin-top: 2px;
  font-size: 22px;
  color: #b89462;
}

.bar {
  margin-top: 10px;
  flex-direction: row;
  justify-content: center;
}

.btn {
  width: 140px;
  height: 48px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #6b4a2a;
}

.btn-text {
  font-size: 22px;
  color: #e8c48a;
}

/* 문서: @keyframes 의 transform(translate/rotate/scale) 지원 */
@keyframes ringStep {
  0% {
    transform: translateY(0px) rotate(0deg);
  }
  45% {
    transform: translateY(14px) rotate(-4deg);
  }
  100% {
    transform: translateY(0px) rotate(0deg);
  }
}

@keyframes plusUp {
  0% {
    transform: translateY(0px);
    opacity: 1;
  }
  100% {
    transform: translateY(-28px);
    opacity: 0;
  }
}
</style>
