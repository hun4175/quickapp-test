<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 뒤로</text>
      </div>
      <text class="title">설정</text>
    </div>

    <text class="label">입력 방식</text>
    <text class="hint">{{inputHint}}</text>

    <div
      class="opt {{inputMode === 'slide' ? 'opt-on' : ''}}"
      onclick="pickSlide"
    >
      <text class="opt-text">슬라이드</text>
      <text class="opt-mark" if="{{inputMode === 'slide'}}">✓</text>
    </div>
    <div
      class="opt {{inputMode === 'touch' ? 'opt-on' : ''}}"
      onclick="pickTouch"
    >
      <text class="opt-text">터치</text>
      <text class="opt-mark" if="{{inputMode === 'touch'}}">✓</text>
    </div>

    <text class="meta">v2.5.3 · S2</text>
  </div>
</template>

<script>
import router from '@system.router'
import { setInputMode, INPUT_MODE_HINTS } from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'

export default {
  private: {
    inputMode: 'slide',
    inputHint: INPUT_MODE_HINTS.slide
  },

  onShow() {
    this.reload()
  },

  onBackPress() {
    router.back()
    return true
  },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },

  async reload() {
    const state = await loadState()
    this.applyLocal(state)
  },

  applyLocal(state) {
    this._state = state
    this.inputMode = state.inputMode || 'slide'
    this.inputHint = INPUT_MODE_HINTS[this.inputMode] || INPUT_MODE_HINTS.slide
  },

  async persist(next) {
    await saveState(next)
    this.applyLocal(next)
  },

  async pickInput(mode) {
    if (!this._state) await this.reload()
    await this.persist(setInputMode(this._state, mode))
  },
  pickSlide() {
    this.pickInput('slide')
  },
  pickTouch() {
    this.pickInput('touch')
  },

  goBack() {
    router.back()
  }
}
</script>

