<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 뒤로</text>
      </div>
      <text class="title">설정</text>
    </div>

    <text class="label">한 바퀴 알 개수</text>
    <div class="row">
      <div class="chip {{beadsPerRound === 108 ? 'chip-on' : ''}}" onclick="pick108">
        <text class="chip-text">108</text>
      </div>
      <div class="chip {{beadsPerRound === 54 ? 'chip-on' : ''}}" onclick="pick54">
        <text class="chip-text">54</text>
      </div>
      <div class="chip {{beadsPerRound === 27 ? 'chip-on' : ''}}" onclick="pick27">
        <text class="chip-text">27</text>
      </div>
      <div class="chip {{beadsPerRound === 21 ? 'chip-on' : ''}}" onclick="pick21">
        <text class="chip-text">21</text>
      </div>
    </div>

    <text class="label">알마다 짧은 진동</text>
    <div class="row">
      <div class="chip {{vibrateOnBead ? 'chip-on' : ''}}" onclick="setVibrateOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!vibrateOnBead ? 'chip-on' : ''}}" onclick="setVibrateOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">입력 방식</text>
    <text class="hint">{{inputHint}}</text>
    <div class="col">
      <div class="chip-wide {{inputMode === 'slide' ? 'chip-on' : ''}}" onclick="pickSlide">
        <text class="chip-text">슬라이드 (위·아래)</text>
      </div>
      <div class="chip-wide {{inputMode === 'touch' ? 'chip-on' : ''}}" onclick="pickTouch">
        <text class="chip-text">터치 (탭=한 칸 앞)</text>
      </div>
    </div>

    <text class="label">진단</text>
    <text class="hint">P1=터치시작 · P2=애니클래스 · ms 표시</text>
    <div class="row">
      <div class="chip {{diagnoseLatency ? 'chip-on' : ''}}" onclick="setDiagOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!diagnoseLatency ? 'chip-on' : ''}}" onclick="setDiagOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">단일 구슬 테스트</text>
    <text class="hint">포커스 1개만 keyframe (노드수 원인 확인)</text>
    <div class="row">
      <div class="chip {{singleBeadTest ? 'chip-on' : ''}}" onclick="setSingleOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!singleBeadTest ? 'chip-on' : ''}}" onclick="setSingleOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">데이터</text>
    <div class="col">
      <div class="action" onclick="confirmSession">
        <text class="action-text">현재 바퀴·알 초기화</text>
      </div>
      <div class="action danger" onclick="confirmAll">
        <text class="action-text">오늘 합계까지 초기화</text>
      </div>
    </div>

    <text class="meta">오늘 {{todayTotal}} · 저장 로컬만 · v2.4.1</text>
  </div>
</template>

<script>
import router from '@system.router'
import {
  setBeadsPerRound,
  setVibrateOnBead,
  setInputMode,
  setDiagnoseLatency,
  setSingleBeadTest,
  INPUT_MODE_HINTS
} from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'

export default {
  private: {
    beadsPerRound: 108,
    vibrateOnBead: true,
    todayTotal: 0,
    inputMode: 'slide',
    inputHint: INPUT_MODE_HINTS.slide,
    diagnoseLatency: false,
    singleBeadTest: false
  },

  onShow() {
    this.reload()
  },

  onBackPress() {
    router.back()
    return true
  },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      router.back()
    }
  },

  async reload() {
    const state = await loadState()
    this.applyLocal(state)
  },

  applyLocal(state) {
    this._state = state
    this.beadsPerRound = state.beadsPerRound
    this.vibrateOnBead = state.vibrateOnBead
    this.todayTotal = state.todayTotal
    this.inputMode = state.inputMode || 'slide'
    this.inputHint = INPUT_MODE_HINTS[this.inputMode] || INPUT_MODE_HINTS.slide
    this.diagnoseLatency = !!state.diagnoseLatency
    this.singleBeadTest = !!state.singleBeadTest
  },

  async persist(next) {
    await saveState(next)
    this.applyLocal(next)
  },

  async pickBeads(n) {
    if (!this._state) await this.reload()
    await this.persist(setBeadsPerRound(this._state, n))
  },

  pick108() {
    this.pickBeads(108)
  },
  pick54() {
    this.pickBeads(54)
  },
  pick27() {
    this.pickBeads(27)
  },
  pick21() {
    this.pickBeads(21)
  },

  async setVibrateOn() {
    if (!this._state) await this.reload()
    await this.persist(setVibrateOnBead(this._state, true))
  },

  async setVibrateOff() {
    if (!this._state) await this.reload()
    await this.persist(setVibrateOnBead(this._state, false))
  },

  async pickInput(mode) {
    if (!this._state) await this.reload()
    await this.persist(setInputMode(this._state, mode))
  },

  pickSlide() {
    this.pickInput('slide')
  },
  pickTouch() {
    this.pickInput('touch')
  },

  async setDiagOn() {
    if (!this._state) await this.reload()
    await this.persist(setDiagnoseLatency(this._state, true))
  },
  async setDiagOff() {
    if (!this._state) await this.reload()
    await this.persist(setDiagnoseLatency(this._state, false))
  },
  async setSingleOn() {
    if (!this._state) await this.reload()
    await this.persist(setSingleBeadTest(this._state, true))
  },
  async setSingleOff() {
    if (!this._state) await this.reload()
    await this.persist(setSingleBeadTest(this._state, false))
  },

  confirmSession() {
    router.push({
      uri: '/pages/confirm',
      params: { mode: 'session' }
    })
  },

  confirmAll() {
    router.push({
      uri: '/pages/confirm',
      params: { mode: 'all' }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #140e0a;
  padding-bottom: 24px;
}

.header {
  width: 100%;
  height: 72px;
  margin-top: 12px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.back {
  position: absolute;
  left: 12px;
  height: 48px;
  padding-left: 8px;
  padding-right: 8px;
  justify-content: center;
}

.back-text {
  font-size: 24px;
  color: #b89462;
}

.title {
  font-size: 28px;
  color: #e8c48a;
  font-weight: bold;
}

.label {
  width: 90%;
  margin-top: 20px;
  margin-bottom: 6px;
  font-size: 20px;
  color: #9a7b55;
}

.hint {
  width: 90%;
  margin-bottom: 10px;
  font-size: 16px;
  color: #6e563c;
}

.row {
  width: 92%;
  flex-direction: row;
  justify-content: space-around;
  flex-wrap: wrap;
}

.col {
  width: 92%;
  flex-direction: column;
  align-items: center;
}

.chip {
  width: 88px;
  height: 48px;
  margin: 4px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.chip-wide {
  width: 92%;
  height: 48px;
  margin-top: 6px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.chip-on {
  background-color: #6b4520;
  border-color: #e8c48a;
}

.chip-text {
  font-size: 22px;
  color: #f3e2c4;
}

.action {
  width: 92%;
  height: 56px;
  margin-top: 10px;
  border-radius: 28px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.danger {
  border-color: #8a3a2a;
  background-color: #3a1812;
}

.action-text {
  font-size: 22px;
  color: #f3e2c4;
}

.meta {
  margin-top: 24px;
  font-size: 18px;
  color: #6e563c;
}
</style>
