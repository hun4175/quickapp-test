<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 뒤로</text>
      </div>
      <text class="title">설정</text>
    </div>

    <text class="label">한 바퀴 알 개수</text>
    <div class="row">
      <div class="chip {{beadsPerRound === 108 ? 'chip-on' : ''}}" onclick="pick108">
        <text class="chip-text">108</text>
      </div>
      <div class="chip {{beadsPerRound === 54 ? 'chip-on' : ''}}" onclick="pick54">
        <text class="chip-text">54</text>
      </div>
      <div class="chip {{beadsPerRound === 27 ? 'chip-on' : ''}}" onclick="pick27">
        <text class="chip-text">27</text>
      </div>
      <div class="chip {{beadsPerRound === 21 ? 'chip-on' : ''}}" onclick="pick21">
        <text class="chip-text">21</text>
      </div>
    </div>

    <text class="label">알마다 짧은 진동</text>
    <div class="row">
      <div class="chip {{vibrateOnBead ? 'chip-on' : ''}}" onclick="setVibrateOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!vibrateOnBead ? 'chip-on' : ''}}" onclick="setVibrateOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">애니 모드 (진단)</text>
    <text class="hint">{{animHint}}</text>
    <div class="col">
      <div class="chip-wide {{animMode === 'A' ? 'chip-on' : ''}}" onclick="pickModeA">
        <text class="chip-text">A 구슬별 키프레임</text>
      </div>
      <div class="chip-wide {{animMode === 'B' ? 'chip-on' : ''}}" onclick="pickModeB">
        <text class="chip-text">B 애니 없음</text>
      </div>
      <div class="chip-wide {{animMode === 'C' ? 'chip-on' : ''}}" onclick="pickModeC">
        <text class="chip-text">C 통 컨테이너</text>
      </div>
    </div>

    <text class="label">지연 디버그</text>
    <text class="hint">구석에 터치→시작·애니 ms 표시</text>
    <div class="row">
      <div class="chip {{debugLatency ? 'chip-on' : ''}}" onclick="setDebugOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!debugLatency ? 'chip-on' : ''}}" onclick="setDebugOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">데이터</text>
    <div class="col">
      <div class="action" onclick="confirmSession">
        <text class="action-text">현재 바퀴·알 초기화</text>
      </div>
      <div class="action danger" onclick="confirmAll">
        <text class="action-text">오늘 합계까지 초기화</text>
      </div>
    </div>

    <text class="meta">오늘 {{todayTotal}} · 저장 로컬만 · v2.1.0</text>
  </div>
</template>

<script>
import router from '@system.router'
import {
  setBeadsPerRound,
  setVibrateOnBead,
  setAnimMode,
  setDebugLatency,
  ANIM_MODE_HINTS
} from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'

export default {
  private: {
    beadsPerRound: 108,
    vibrateOnBead: true,
    todayTotal: 0,
    animMode: 'A',
    debugLatency: false,
    animHint: ANIM_MODE_HINTS.A
  },

  onShow() {
    this.reload()
  },

  onBackPress() {
    router.back()
    return true
  },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      router.back()
    }
  },

  async reload() {
    const state = await loadState()
    this.applyLocal(state)
  },

  applyLocal(state) {
    this._state = state
    this.beadsPerRound = state.beadsPerRound
    this.vibrateOnBead = state.vibrateOnBead
    this.todayTotal = state.todayTotal
    this.animMode = state.animMode || 'A'
    this.debugLatency = !!state.debugLatency
    this.animHint = ANIM_MODE_HINTS[this.animMode] || ANIM_MODE_HINTS.A
  },

  async persist(next) {
    await saveState(next)
    this.applyLocal(next)
  },

  async pickBeads(n) {
    if (!this._state) await this.reload()
    await this.persist(setBeadsPerRound(this._state, n))
  },

  pick108() {
    this.pickBeads(108)
  },
  pick54() {
    this.pickBeads(54)
  },
  pick27() {
    this.pickBeads(27)
  },
  pick21() {
    this.pickBeads(21)
  },

  async setVibrateOn() {
    if (!this._state) await this.reload()
    await this.persist(setVibrateOnBead(this._state, true))
  },

  async setVibrateOff() {
    if (!this._state) await this.reload()
    await this.persist(setVibrateOnBead(this._state, false))
  },

  async pickMode(mode) {
    if (!this._state) await this.reload()
    await this.persist(setAnimMode(this._state, mode))
  },

  pickModeA() {
    this.pickMode('A')
  },
  pickModeB() {
    this.pickMode('B')
  },
  pickModeC() {
    this.pickMode('C')
  },

  async setDebugOn() {
    if (!this._state) await this.reload()
    await this.persist(setDebugLatency(this._state, true))
  },

  async setDebugOff() {
    if (!this._state) await this.reload()
    await this.persist(setDebugLatency(this._state, false))
  },

  confirmSession() {
    router.push({
      uri: '/pages/confirm',
      params: { mode: 'session' }
    })
  },

  confirmAll() {
    router.push({
      uri: '/pages/confirm',
      params: { mode: 'all' }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #140e0a;
  padding-bottom: 24px;
}

.header {
  width: 100%;
  height: 72px;
  margin-top: 12px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.back {
  position: absolute;
  left: 12px;
  height: 48px;
  padding-left: 8px;
  padding-right: 8px;
  justify-content: center;
}

.back-text {
  font-size: 24px;
  color: #b89462;
}

.title {
  font-size: 28px;
  color: #e8c48a;
  font-weight: bold;
}

.label {
  width: 90%;
  margin-top: 20px;
  margin-bottom: 6px;
  font-size: 20px;
  color: #9a7b55;
}

.hint {
  width: 90%;
  margin-bottom: 10px;
  font-size: 16px;
  color: #6e563c;
}

.row {
  width: 92%;
  flex-direction: row;
  justify-content: space-around;
  flex-wrap: wrap;
}

.col {
  width: 92%;
  flex-direction: column;
  align-items: center;
}

.chip {
  width: 88px;
  height: 48px;
  margin: 4px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.chip-wide {
  width: 92%;
  height: 48px;
  margin-top: 6px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.chip-on {
  background-color: #6b4520;
  border-color: #e8c48a;
}

.chip-text {
  font-size: 22px;
  color: #f3e2c4;
}

.action {
  width: 92%;
  height: 56px;
  margin-top: 10px;
  border-radius: 28px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.danger {
  border-color: #8a3a2a;
  background-color: #3a1812;
}

.action-text {
  font-size: 22px;
  color: #f3e2c4;
}

.meta {
  margin-top: 24px;
  font-size: 18px;
  color: #6e563c;
}
</style>
