<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 뒤로</text>
      </div>
      <text class="title">설정</text>
    </div>

    <text class="label">입력 방식</text>
    <text class="hint">{{inputHint}}</text>
    <div class="row">
      <div class="chip {{inputMode === 'slide' ? 'chip-on' : ''}}" onclick="pickSlide">
        <text class="chip-text">슬라이드</text>
      </div>
      <div class="chip {{inputMode === 'touch' ? 'chip-on' : ''}}" onclick="pickTouch">
        <text class="chip-text">터치</text>
      </div>
    </div>

    <text class="label">타이밍 표시</text>
    <text class="hint">진단 패널 · 기본 끔</text>
    <div class="row">
      <div class="chip {{diagnoseLatency ? 'chip-on' : ''}}" onclick="setDiagOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!diagnoseLatency ? 'chip-on' : ''}}" onclick="setDiagOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>
    <div class="col" if="{{diagnoseLatency}}">
      <div class="chip-wide" onclick="openDiagLog">
        <text class="chip-text">최근 측정값 보기</text>
      </div>
    </div>

    <text class="meta">v2.5.1 · S2</text>
  </div>
</template>

<script>
import router from '@system.router'
import {
  setInputMode,
  setDiagnoseLatency,
  INPUT_MODE_HINTS
} from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'

export default {
  private: {
    inputMode: 'slide',
    inputHint: INPUT_MODE_HINTS.slide,
    diagnoseLatency: false
  },

  onShow() {
    this.reload()
  },

  onBackPress() {
    router.back()
    return true
  },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },

  async reload() {
    const state = await loadState()
    this.applyLocal(state)
  },

  applyLocal(state) {
    this._state = state
    this.inputMode = state.inputMode || 'slide'
    this.inputHint = INPUT_MODE_HINTS[this.inputMode] || INPUT_MODE_HINTS.slide
    this.diagnoseLatency = !!state.diagnoseLatency
  },

  async persist(next) {
    await saveState(next)
    this.applyLocal(next)
  },

  async pickInput(mode) {
    if (!this._state) await this.reload()
    await this.persist(setInputMode(this._state, mode))
  },
  pickSlide() {
    this.pickInput('slide')
  },
  pickTouch() {
    this.pickInput('touch')
  },

  async setDiagOn() {
    if (!this._state) await this.reload()
    await this.persist(setDiagnoseLatency(this._state, true))
  },
  async setDiagOff() {
    if (!this._state) await this.reload()
    await this.persist(setDiagnoseLatency(this._state, false))
  },

  openDiagLog() {
    router.push({ uri: '/pages/diag' })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #140e0a;
  padding-bottom: 24px;
}
.header {
  width: 100%;
  height: 72px;
  margin-top: 12px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.back {
  position: absolute;
  left: 12px;
  height: 48px;
  padding-left: 8px;
  padding-right: 8px;
  justify-content: center;
}
.back-text {
  font-size: 24px;
  color: #b89462;
}
.title {
  font-size: 28px;
  color: #e8c48a;
  font-weight: bold;
}
.label {
  width: 90%;
  margin-top: 18px;
  margin-bottom: 4px;
  font-size: 22px;
  color: #9a7b55;
}
.hint {
  width: 90%;
  margin-bottom: 8px;
  font-size: 18px;
  color: #6e563c;
}
.row {
  width: 92%;
  flex-direction: row;
  justify-content: center;
  flex-wrap: wrap;
}
.col {
  width: 92%;
  flex-direction: column;
  align-items: center;
  margin-top: 8px;
}
.chip {
  height: 48px;
  min-width: 96px;
  margin: 4px;
  padding-left: 14px;
  padding-right: 14px;
  background-color: #2a1e14;
  border-width: 2px;
  border-color: #3a2a18;
  justify-content: center;
  align-items: center;
}
.chip-on {
  border-color: #e8c48a;
  background-color: #3a2a18;
}
.chip-wide {
  width: 90%;
  height: 48px;
  margin-top: 4px;
  background-color: #2a1e14;
  border-width: 2px;
  border-color: #3a2a18;
  justify-content: center;
  align-items: center;
}
.chip-text {
  font-size: 22px;
  color: #f3e2c4;
  text-align: center;
}
.meta {
  margin-top: 28px;
  font-size: 16px;
  color: #6e563c;
}
</style>
