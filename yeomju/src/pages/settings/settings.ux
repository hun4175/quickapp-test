<template>
  <div class="page" onswipe="onSwipe">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">‹ 뒤로</text>
      </div>
      <text class="title">설정</text>
    </div>

    <text class="label">한 바퀴 알 개수</text>
    <div class="row">
      <div class="chip {{beadsPerRound === 108 ? 'chip-on' : ''}}" onclick="pick108">
        <text class="chip-text">108</text>
      </div>
      <div class="chip {{beadsPerRound === 54 ? 'chip-on' : ''}}" onclick="pick54">
        <text class="chip-text">54</text>
      </div>
      <div class="chip {{beadsPerRound === 27 ? 'chip-on' : ''}}" onclick="pick27">
        <text class="chip-text">27</text>
      </div>
      <div class="chip {{beadsPerRound === 21 ? 'chip-on' : ''}}" onclick="pick21">
        <text class="chip-text">21</text>
      </div>
    </div>

    <text class="label">알마다 짧은 진동</text>
    <div class="row">
      <div class="chip {{vibrateOnBead ? 'chip-on' : ''}}" onclick="setVibrateOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!vibrateOnBead ? 'chip-on' : ''}}" onclick="setVibrateOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">입력 방식</text>
    <text class="hint">{{inputHint}}</text>
    <div class="col">
      <div class="chip-wide {{inputMode === 'slide' ? 'chip-on' : ''}}" onclick="pickSlide">
        <text class="chip-text">슬라이드 (위·아래)</text>
      </div>
      <div class="chip-wide {{inputMode === 'touch' ? 'chip-on' : ''}}" onclick="pickTouch">
        <text class="chip-text">터치 (탭=한 칸 앞)</text>
      </div>
    </div>

    <text class="label">진단</text>
    <text class="hint">타이밍 in→set / set→start / anim · 중앙 표시</text>
    <div class="row">
      <div class="chip {{diagnoseLatency ? 'chip-on' : ''}}" onclick="setDiagOn">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!diagnoseLatency ? 'chip-on' : ''}}" onclick="setDiagOff">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">표시 구슬 수</text>
    <text class="hint">1=포커스 · 3=앞열 · 6=화면 · 10=전체(기본)</text>
    <div class="row">
      <div class="chip {{visibleBeadCount === 1 ? 'chip-on' : ''}}" onclick="pickCount1">
        <text class="chip-text">1</text>
      </div>
      <div class="chip {{visibleBeadCount === 3 ? 'chip-on' : ''}}" onclick="pickCount3">
        <text class="chip-text">3</text>
      </div>
      <div class="chip {{visibleBeadCount === 6 ? 'chip-on' : ''}}" onclick="pickCount6">
        <text class="chip-text">6</text>
      </div>
      <div class="chip {{visibleBeadCount === 10 ? 'chip-on' : ''}}" onclick="pickCount10">
        <text class="chip-text">10</text>
      </div>
    </div>

    <text class="label">실험 E1 애니 최소화</text>
    <text class="hint">버퍼↔버퍼 생략 · 기본 켜짐</text>
    <div class="row">
      <div class="chip {{e1Minimize ? 'chip-on' : ''}}" onclick="setE1On">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!e1Minimize ? 'chip-on' : ''}}" onclick="setE1Off">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">실험 E2 scale 제거</text>
    <text class="hint">translate만 · 형상 변경 · 기본 끔</text>
    <div class="row">
      <div class="chip {{e2NoScale ? 'chip-on' : ''}}" onclick="setE2On">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!e2NoScale ? 'chip-on' : ''}}" onclick="setE2Off">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">실험 E3 뒷열 저해상</text>
    <text class="hint">앞255/뒤160 · 기본 켜짐</text>
    <div class="row">
      <div class="chip {{e3SplitSrc ? 'chip-on' : ''}}" onclick="setE3On">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!e3SplitSrc ? 'chip-on' : ''}}" onclick="setE3Off">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">실험 E4 뒷열 스냅</text>
    <text class="hint">뒷열 애니 생략 · 기본 끔</text>
    <div class="row">
      <div class="chip {{e4SkipBack ? 'chip-on' : ''}}" onclick="setE4On">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!e4SkipBack ? 'chip-on' : ''}}" onclick="setE4Off">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">실험 E5 $element 클래스</text>
    <text class="hint">바인딩 대신 직접 클래스 · API 없으면 불가</text>
    <div class="row">
      <div class="chip {{e5DirectDom ? 'chip-on' : ''}}" onclick="setE5On">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!e5DirectDom ? 'chip-on' : ''}}" onclick="setE5Off">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">실험 E6 단색 원</text>
    <text class="hint">이미지 대신 div 원 · 디코드 분리 · 기본 끔</text>
    <div class="row">
      <div class="chip {{e6Solid ? 'chip-on' : ''}}" onclick="setE6On">
        <text class="chip-text">켜기</text>
      </div>
      <div class="chip {{!e6Solid ? 'chip-on' : ''}}" onclick="setE6Off">
        <text class="chip-text">끄기</text>
      </div>
    </div>

    <text class="label">데이터</text>
    <div class="col">
      <div class="action" onclick="confirmSession">
        <text class="action-text">현재 바퀴·알 초기화</text>
      </div>
      <div class="action danger" onclick="confirmAll">
        <text class="action-text">오늘 합계까지 초기화</text>
      </div>
    </div>

    <text class="meta">오늘 {{todayTotal}} · 저장 로컬만 · v2.4.3</text>
  </div>
</template>

<script>
import router from '@system.router'
import {
  setBeadsPerRound,
  setVibrateOnBead,
  setInputMode,
  setDiagnoseLatency,
  setVisibleBeadCount,
  setE1Minimize,
  setE2NoScale,
  setE3SplitSrc,
  setE4SkipBack,
  setE5DirectDom,
  setE6Solid,
  INPUT_MODE_HINTS
} from '../../common/beads.js'
import { loadState, saveState } from '../../common/persist.js'

export default {
  private: {
    beadsPerRound: 108,
    vibrateOnBead: true,
    todayTotal: 0,
    inputMode: 'slide',
    inputHint: INPUT_MODE_HINTS.slide,
    diagnoseLatency: false,
    visibleBeadCount: 10,
    e1Minimize: true,
    e2NoScale: false,
    e3SplitSrc: true,
    e4SkipBack: false,
    e5DirectDom: false,
    e6Solid: false
  },

  onShow() {
    this.reload()
  },

  onBackPress() {
    router.back()
    return true
  },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      router.back()
    }
  },

  async reload() {
    const state = await loadState()
    this.applyLocal(state)
  },

  applyLocal(state) {
    this._state = state
    this.beadsPerRound = state.beadsPerRound
    this.vibrateOnBead = state.vibrateOnBead
    this.todayTotal = state.todayTotal
    this.inputMode = state.inputMode || 'slide'
    this.inputHint = INPUT_MODE_HINTS[this.inputMode] || INPUT_MODE_HINTS.slide
    this.diagnoseLatency = !!state.diagnoseLatency
    this.visibleBeadCount = state.visibleBeadCount || 10
    this.e1Minimize = state.e1Minimize !== false
    this.e2NoScale = !!state.e2NoScale
    this.e3SplitSrc = state.e3SplitSrc !== false
    this.e4SkipBack = !!state.e4SkipBack
    this.e5DirectDom = !!state.e5DirectDom
    this.e6Solid = !!state.e6Solid
  },

  async persist(next) {
    await saveState(next)
    this.applyLocal(next)
  },

  async pickBeads(n) {
    if (!this._state) await this.reload()
    await this.persist(setBeadsPerRound(this._state, n))
  },

  pick108() {
    this.pickBeads(108)
  },
  pick54() {
    this.pickBeads(54)
  },
  pick27() {
    this.pickBeads(27)
  },
  pick21() {
    this.pickBeads(21)
  },

  async setVibrateOn() {
    if (!this._state) await this.reload()
    await this.persist(setVibrateOnBead(this._state, true))
  },

  async setVibrateOff() {
    if (!this._state) await this.reload()
    await this.persist(setVibrateOnBead(this._state, false))
  },

  async pickInput(mode) {
    if (!this._state) await this.reload()
    await this.persist(setInputMode(this._state, mode))
  },

  pickSlide() {
    this.pickInput('slide')
  },
  pickTouch() {
    this.pickInput('touch')
  },

  async setDiagOn() {
    if (!this._state) await this.reload()
    await this.persist(setDiagnoseLatency(this._state, true))
  },
  async setDiagOff() {
    if (!this._state) await this.reload()
    await this.persist(setDiagnoseLatency(this._state, false))
  },

  async pickCount(n) {
    if (!this._state) await this.reload()
    await this.persist(setVisibleBeadCount(this._state, n))
  },
  pickCount1() {
    this.pickCount(1)
  },
  pickCount3() {
    this.pickCount(3)
  },
  pickCount6() {
    this.pickCount(6)
  },
  pickCount10() {
    this.pickCount(10)
  },

  async setE1On() {
    if (!this._state) await this.reload()
    await this.persist(setE1Minimize(this._state, true))
  },
  async setE1Off() {
    if (!this._state) await this.reload()
    await this.persist(setE1Minimize(this._state, false))
  },
  async setE2On() {
    if (!this._state) await this.reload()
    await this.persist(setE2NoScale(this._state, true))
  },
  async setE2Off() {
    if (!this._state) await this.reload()
    await this.persist(setE2NoScale(this._state, false))
  },
  async setE3On() {
    if (!this._state) await this.reload()
    await this.persist(setE3SplitSrc(this._state, true))
  },
  async setE3Off() {
    if (!this._state) await this.reload()
    await this.persist(setE3SplitSrc(this._state, false))
  },
  async setE4On() {
    if (!this._state) await this.reload()
    await this.persist(setE4SkipBack(this._state, true))
  },
  async setE4Off() {
    if (!this._state) await this.reload()
    await this.persist(setE4SkipBack(this._state, false))
  },
  async setE5On() {
    if (!this._state) await this.reload()
    await this.persist(setE5DirectDom(this._state, true))
  },
  async setE5Off() {
    if (!this._state) await this.reload()
    await this.persist(setE5DirectDom(this._state, false))
  },
  async setE6On() {
    if (!this._state) await this.reload()
    await this.persist(setE6Solid(this._state, true))
  },
  async setE6Off() {
    if (!this._state) await this.reload()
    await this.persist(setE6Solid(this._state, false))
  },

  confirmSession() {
    router.push({
      uri: '/pages/confirm',
      params: { mode: 'session' }
    })
  },

  confirmAll() {
    router.push({
      uri: '/pages/confirm',
      params: { mode: 'all' }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #140e0a;
  padding-bottom: 24px;
}

.header {
  width: 100%;
  height: 72px;
  margin-top: 12px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.back {
  position: absolute;
  left: 12px;
  height: 48px;
  padding-left: 8px;
  padding-right: 8px;
  justify-content: center;
}

.back-text {
  font-size: 24px;
  color: #b89462;
}

.title {
  font-size: 28px;
  color: #e8c48a;
  font-weight: bold;
}

.label {
  width: 90%;
  margin-top: 20px;
  margin-bottom: 6px;
  font-size: 20px;
  color: #9a7b55;
}

.hint {
  width: 90%;
  margin-bottom: 10px;
  font-size: 16px;
  color: #6e563c;
}

.row {
  width: 92%;
  flex-direction: row;
  justify-content: space-around;
  flex-wrap: wrap;
}

.col {
  width: 92%;
  flex-direction: column;
  align-items: center;
}

.chip {
  width: 88px;
  height: 48px;
  margin: 4px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.chip-wide {
  width: 92%;
  height: 48px;
  margin-top: 6px;
  border-radius: 24px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.chip-on {
  background-color: #6b4520;
  border-color: #e8c48a;
}

.chip-text {
  font-size: 22px;
  color: #f3e2c4;
}

.action {
  width: 92%;
  height: 56px;
  margin-top: 10px;
  border-radius: 28px;
  background-color: #2a1c12;
  justify-content: center;
  align-items: center;
  border-width: 1px;
  border-color: #4a3420;
}

.danger {
  border-color: #8a3a2a;
  background-color: #3a1812;
}

.action-text {
  font-size: 22px;
  color: #f3e2c4;
}

.meta {
  margin-top: 24px;
  font-size: 18px;
  color: #6e563c;
}
</style>
