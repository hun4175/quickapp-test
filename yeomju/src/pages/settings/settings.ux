  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #140e0a;
  padding-left: 36px;
  padding-right: 36px;
  padding-top: 28px;
  padding-bottom: 36px;
}
.header {
  width: 100%;
  height: 72px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}
.back {
  position: absolute;
  left: 36px;
  height: 64px;
  padding-left: 4px;
  padding-right: 12px;
  justify-content: center;
}
.back-text {
  font-size: 30px;
  color: #b89462;
}
.title {
  font-size: 36px;
  color: #e8c48a;
  font-weight: bold;
}
.label {
  width: 100%;
  margin-top: 20px;
  margin-bottom: 6px;
  font-size: 28px;
  color: #9a7b55;
}
.hint {
  width: 100%;
  margin-bottom: 16px;
  font-size: 24px;
  color: #6e563c;
}
.opt {
  width: 100%;
  height: 96px;
  margin-bottom: 14px;
  padding-left: 22px;
  padding-right: 22px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #2a1e14;
  border-width: 3px;
  border-color: #3a2a18;
}
.opt-on {
  border-color: #e8c48a;
  background-color: #4a3420;
}
.opt-text {
  font-size: 32px;
  color: #f3e2c4;
}
.opt-mark {
  font-size: 34px;
  color: #e8c48a;
  font-weight: bold;
}
.meta {
  margin-top: 24px;
  font-size: 20px;
  color: #6e563c;
}
</style>
