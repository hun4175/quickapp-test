<template>
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd"
    ontouchcancel="onTouchCancel"
  >
    <div class="view" if="{{view === 'setup'}}">
      <image class="st-bg" src="/common/setup/bg.png"></image>
      <image class="st-f1" src="{{f1Src}}"></image>
      <image class="st-f2" src="{{f2Src}}"></image>
      <image class="st-fprev1" if="{{fPrevShow}}" src="{{fPrev1Src}}"></image>
      <image class="st-fprev2" if="{{fPrevShow}}" src="{{fPrev2Src}}"></image>
      <image class="st-fnext1" if="{{fNextShow}}" src="{{fNext1Src}}"></image>
      <image class="st-fnext2" if="{{fNextShow}}" src="{{fNext2Src}}"></image>
      <image class="st-r1" src="{{r1Src}}"></image>
      <image class="st-r2" src="{{r2Src}}"></image>
      <image class="st-rprev1" if="{{rPrevShow}}" src="{{rPrev1Src}}"></image>
      <image class="st-rprev2" if="{{rPrevShow}}" src="{{rPrev2Src}}"></image>
      <image class="st-rnext1" if="{{rNextShow}}" src="{{rNext1Src}}"></image>
      <image class="st-rnext2" if="{{rNextShow}}" src="{{rNext2Src}}"></image>
      <image class="st-tog" src="{{toggleSrc}}"></image>
    </div>
    <div class="view" if="{{view === 'timer'}}">
      <image class="gauge" src="{{gaugeSrc}}"></image>
      <image class="label" src="{{labelSrc}}"></image>
      <image class="dm dm1" src="{{m1Src}}"></image>
      <image class="dm dm2" src="{{m2Src}}"></image>
      <image class="colon" src="/common/booster/colon.png"></image>
      <image class="ds ds1" src="{{s1Src}}"></image>
      <image class="ds ds2" src="{{s2Src}}"></image>
      <div class="pause" if="{{paused}}">
        <div class="bar"></div>
        <div class="bar bar-r"></div>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 뽀모도로 0.1.6 (REDMI Watch 6 글로벌 · 432x514).
 * 한 페이지 안에 독립 뷰 두 개: view === 'setup'(설정) / 'timer'(부스터 계기판).
 * 별도 페이지(router) 대신 한 페이지로 둔 이유:
 *  - "백그라운드에서 돌아오면 항상 설정부터"를 onShow 하나로 처리한다. 페이지를 나누면
 *    설정 → 타이머 → (router.back) 때도 onShow 가 불려 복귀와 구분이 안 된다.
 *  - 페이지 스택이 없어 시스템 뒤로(오른쪽 스와이프)가 숨은 타이머 페이지로 가는 경우가 없다.
 *  - router 를 쓰지 않으면 manifest·권한이 그대로다.
 * 설정: 집중(5~60분, 5분 단위)·휴식(1~30분, 1분 단위) 값을 좌우로 끌어 바꾸고(왼쪽 끌기=늘림),
 *       값 줄 좌/우 끝을 탭해도 한 칸씩 바뀐다. REPEAT 줄 탭=반복 토글, START 탭=시작.
 * 시작: 설정 뷰를 닫고 게이지를 0칸→36칸으로 약 0.9초 채운 뒤 카운트다운 시작.
 * 타이머: 탭=일시정지/재개, 길게 누르기=중지 후 설정으로.
 * 초기화: onInit/onShow 에서 항상 설정 뷰, 진행 중 타이머는 버린다(설정값만 저장).
 * 소리·audio·muted·볼륨 API는 쓰지 않는다.
 */
import vibrator from '@system.vibrator'
import { loadSettings, saveSettings } from '../../common/persist.js'
import {
  TICK_MS,
  LONGPRESS_MS,
  VIBRATE_OFFSETS_MS,
  TAP_MAX_MOVE,
  INTRO_MS,
  INTRO_FRAME_MS,
  defaultSettings,
  normalizeSettings,
  stepSetting,
  toggleRepeat,
  scrollSteps,
  setupHit,
  tapSide,
  setupViewModel,
  armedState,
  start,
  toggle,
  advance,
  introLit,
  viewModel
} from '../../common/timer.js'

/** 끌기 직후 이 시간(ms) 안의 뒤로 이벤트는 값 끌기로 보고 삼킨다. */
const BACK_GUARD_MS = 400

export default {
  private: {
    view: 'setup',
    f1Src: '/common/setup/f2.png',
    f2Src: '/common/setup/f5.png',
    r1Src: '/common/setup/r0.png',
    r2Src: '/common/setup/r5.png',
    fPrevShow: true,
    fPrev1Src: '/common/setup/n2.png',
    fPrev2Src: '/common/setup/n0.png',
    fNextShow: true,
    fNext1Src: '/common/setup/n3.png',
    fNext2Src: '/common/setup/n0.png',
    rPrevShow: true,
    rPrev1Src: '/common/setup/n0.png',
    rPrev2Src: '/common/setup/n4.png',
    rNextShow: true,
    rNext1Src: '/common/setup/n0.png',
    rNext2Src: '/common/setup/n6.png',
    toggleSrc: '/common/setup/tog-on.png',
    gaugeSrc: '/common/booster/g36.png',
    labelSrc: '/common/booster/focus.png',
    m1Src: '/common/booster/m2.png',
    m2Src: '/common/booster/m5.png',
    s1Src: '/common/booster/s0.png',
    s2Src: '/common/booster/s0.png',
    paused: false
  },

  onInit() {
    this._settings = defaultSettings()
    this._state = null
    this._tickTimer = null
    this._introTimer = null
    this._introAt = 0
    this._lpTimer = null
    this._vibTimers = []
    this._touchActive = false
    this._longPressed = false
    this._touchX = 0
    this._touchY = 0
    this._touchRow = null
    this._dragSteps = 0
    this._dragged = false
    this._lastDragAt = 0
    this._settingsTouched = false
    this.goSetup(false)
  },

  onShow() {
    // 첫 실행이든 백그라운드에서 돌아온 것이든 항상 설정부터. 진행 중 타이머는 버린다.
    this.goSetup(false)
    this._settingsTouched = false
    const self = this
    loadSettings().then(function (s) {
      if (self._settingsTouched || self.view !== 'setup') return
      self._settings = normalizeSettings(s)
      self.applySetup()
    })
  },

  onHide() {
    this.goSetup(false)
    saveSettings(this._settings)
  },

  onDestroy() {
    this.stopAll(false)
  },

  onBackPress() {
    // 시스템 뒤로 = 오른쪽 스와이프. 설정에서 값을 끄는 중이면 앱을 닫지 않는다.
    if (this.view === 'setup') {
      if (this._touchActive && this._dragged) return true
      if (Date.now() - this._lastDragAt < BACK_GUARD_MS) return true
    }
    return false
  },

  /* ---------- 화면 전환 ---------- */

  stopAll(keepVibe) {
    this.stopTick()
    this.stopIntro()
    this.clearLpTimer()
    if (!keepVibe) this.clearVibrateTimers()
    this.setKeepScreen(false)
  },

  goSetup(keepVibe) {
    this.stopAll(keepVibe)
    this._state = null
    this.paused = false
    this.applySetup()
    this.view = 'setup'
  },

  applySetup() {
    const v = setupViewModel(this._settings)
    const keys = [
      'f1Src', 'f2Src', 'r1Src', 'r2Src',
      'fPrevShow', 'fPrev1Src', 'fPrev2Src', 'fNextShow', 'fNext1Src', 'fNext2Src',
      'rPrevShow', 'rPrev1Src', 'rPrev2Src', 'rNextShow', 'rNext1Src', 'rNext2Src',
      'toggleSrc'
    ]
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      if (this[k] !== v[k]) this[k] = v[k]
    }
  },

  changeSettings(next) {
    this._settings = next
    this._settingsTouched = true
    this.applySetup()
  },

  /** START: 설정 뷰 닫기 → 게이지 0칸에서 36칸까지 채우는 시작 애니메이션 → 카운트다운. */
  beginSession() {
    saveSettings(this._settings)
    this.stopAll(false)
    this._state = armedState(this._settings)
    this.applyTimer(0)
    this.view = 'timer'
    this.setKeepScreen(true)
    this._introAt = Date.now()
    const self = this
    this._introTimer = setInterval(function () {
      self.onIntroFrame()
    }, INTRO_FRAME_MS)
  },

  onIntroFrame() {
    const elapsed = Date.now() - this._introAt
    if (elapsed < INTRO_MS) {
      this.applyTimer(introLit(elapsed))
      return
    }
    this.stopIntro()
    this._state = start(this._state, Date.now())
    this.applyTimer()
    this.startTick()
  },

  stopIntro() {
    if (this._introTimer) {
      clearInterval(this._introTimer)
      this._introTimer = null
    }
  },

  applyTimer(litOverride) {
    if (!this._state) return
    const v = viewModel(this._state, litOverride)
    // 바뀐 값만 넣어 image src 재로딩을 줄인다.
    if (this.gaugeSrc !== v.gaugeSrc) this.gaugeSrc = v.gaugeSrc
    if (this.labelSrc !== v.labelSrc) this.labelSrc = v.labelSrc
    if (this.m1Src !== v.m1Src) this.m1Src = v.m1Src
    if (this.m2Src !== v.m2Src) this.m2Src = v.m2Src
    if (this.s1Src !== v.s1Src) this.s1Src = v.s1Src
    if (this.s2Src !== v.s2Src) this.s2Src = v.s2Src
    if (this.paused !== v.paused) this.paused = v.paused
  },

  /* ---------- 타이머 ---------- */

  startTick() {
    this.stopTick()
    const self = this
    this._tickTimer = setInterval(function () {
      self.onTick()
    }, TICK_MS)
  },

  stopTick() {
    if (this._tickTimer) {
      clearInterval(this._tickTimer)
      this._tickTimer = null
    }
  },

  onTick() {
    if (!this._state) return
    const result = advance(this._state, Date.now())
    this._state = result.state
    if (result.crossed > 0) this.pulseVibrate()
    if (result.finished) {
      // 반복 끔: 집중+휴식 한 번이 끝나면 진동 후 설정으로
      this.goSetup(true)
      return
    }
    this.applyTimer()
  },

  onToggle() {
    if (!this._state || this._introTimer) return
    this._state = toggle(this._state, Date.now())
    this.applyTimer()
    if (this._state.running) {
      this.startTick()
      this.setKeepScreen(true)
    } else {
      this.stopTick()
      this.setKeepScreen(false)
    }
  },

  setKeepScreen(on) {
    // import 시점 실패를 피하려고 호출할 때만 require 한다. API가 없어도 앱은 죽지 않는다.
    try {
      const brightness = require('@system.brightness')
      if (!brightness || typeof brightness.setKeepScreenOn !== 'function') return
      brightness.setKeepScreenOn({
        keepScreenOn: !!on,
        fail: function () {}
      })
    } catch (e) {}
  },

  pulseVibrate() {
    this.clearVibrateTimers()
    const self = this
    for (let i = 0; i < VIBRATE_OFFSETS_MS.length; i++) {
      const delay = VIBRATE_OFFSETS_MS[i]
      const timer = setTimeout(function () {
        self.safeVibrate()
      }, delay)
      this._vibTimers.push(timer)
    }
  },

  safeVibrate() {
    try {
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {}
  },

  clearVibrateTimers() {
    if (this._vibTimers && this._vibTimers.length) {
      for (let i = 0; i < this._vibTimers.length; i++) {
        clearTimeout(this._vibTimers[i])
      }
    }
    this._vibTimers = []
  },

  clearLpTimer() {
    if (this._lpTimer) {
      clearTimeout(this._lpTimer)
      this._lpTimer = null
    }
  },

  /* ---------- 터치 ---------- */

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    this._touchActive = true
    this._longPressed = false
    this._dragged = false
    this._dragSteps = 0
    this._touchX = p ? p.x : 0
    this._touchY = p ? p.y : 0
    this.clearLpTimer()
    if (this.view === 'setup') {
      this._touchRow = p ? setupHit(p.x, p.y) : null
      return
    }
    // 타이머: 길게 누르면 중지하고 설정으로(시작 애니메이션 중에도)
    const self = this
    this._lpTimer = setTimeout(function () {
      self._lpTimer = null
      if (!self._touchActive) return
      self._longPressed = true
      self._touchActive = false
      self.goSetup(false)
    }, LONGPRESS_MS)
  },

  onTouchMove(e) {
    if (!this._touchActive || this._longPressed) return
    const p = this.touchPoint(e)
    if (!p) return
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    if (this.view === 'setup') {
      const row = this._touchRow
      if (row !== 'focus' && row !== 'break') return
      if (Math.abs(dx) < Math.abs(dy)) return
      const steps = scrollSteps(dx)
      if (steps !== this._dragSteps) {
        let next = this._settings
        const dir = steps > this._dragSteps ? 1 : -1
        for (let i = this._dragSteps; i !== steps; i += dir) next = stepSetting(next, row, dir)
        this._dragSteps = steps
        this.changeSettings(next)
      }
      if (Math.abs(dx) > TAP_MAX_MOVE) {
        this._dragged = true
        this._lastDragAt = Date.now()
      }
      return
    }
    if (dx * dx + dy * dy > TAP_MAX_MOVE * TAP_MAX_MOVE) this.clearLpTimer()
  },

  onTouchEnd(e) {
    this.clearLpTimer()
    if (!this._touchActive) return
    this._touchActive = false
    if (this._longPressed) return
    const p = this.touchPoint(e)
    const dx = p ? p.x - this._touchX : 0
    const dy = p ? p.y - this._touchY : 0
    const isTap = dx * dx + dy * dy <= TAP_MAX_MOVE * TAP_MAX_MOVE
    if (this.view === 'setup') {
      if (this._dragged || this._dragSteps !== 0) {
        this._lastDragAt = Date.now()
        saveSettings(this._settings)
        return
      }
      if (!isTap) return
      const row = this._touchRow
      if (row === 'focus' || row === 'break') {
        const side = tapSide(this._touchX)
        if (side) {
          this.changeSettings(stepSetting(this._settings, row, side))
          saveSettings(this._settings)
        }
      } else if (row === 'repeat') {
        this.changeSettings(toggleRepeat(this._settings))
        saveSettings(this._settings)
      } else if (row === 'start') {
        this.beginSession()
      }
      return
    }
    if (isTap) this.onToggle()
  },

  onTouchCancel() {
    this.clearLpTimer()
    this._touchActive = false
  }
}
</script>

<style>
