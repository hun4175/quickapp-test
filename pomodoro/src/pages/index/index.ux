<template>
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd"
    ontouchcancel="onTouchCancel"
  >
    <div class="view" if="{{view === 'setup'}}">
      <div class="m-focusTrack"></div>
      <div class="m-focusFill" style="top: {{focusFillTop}}px; height: {{focusFillH}}px;"></div>
      <div class="m-focusActive" if="{{fActive}}"></div>
      <div class="m-focusTick1"></div>
      <div class="m-focusTick2"></div>
      <div class="m-focusTick3"></div>
      <div class="m-focusTick4"></div>
      <div class="m-focusTick5"></div>
      <div class="m-focusTick6"></div>
      <div class="m-focusTick7"></div>
      <div class="m-focusTick8"></div>
      <div class="m-focusTick9"></div>
      <div class="m-focusTick10"></div>
      <div class="m-focusTick11"></div>
      <text class="m-focusLab">FOCUS</text>
      <text class="m-focusNum">{{focusNum}}</text>
      <text class="m-focusUnit">MIN</text>
      <div class="m-restTrack"></div>
      <div class="m-restFill" style="top: {{restFillTop}}px; height: {{restFillH}}px;"></div>
      <div class="m-restActive" if="{{rActive}}"></div>
      <div class="m-restTick1"></div>
      <div class="m-restTick2"></div>
      <div class="m-restTick3"></div>
      <div class="m-restTick4"></div>
      <div class="m-restTick5"></div>
      <text class="m-restLab">REST</text>
      <text class="m-restNum">{{restNum}}</text>
      <text class="m-restUnit">MIN</text>
      <div class="m-start" style="background-color: {{startColor}};"></div>
      <text class="m-startTxt">START</text>
      <text class="m-repLab" style="color: {{repLabColor}};">REPEAT</text>
      <div class="m-tog" style="background-color: {{togColor}};"></div>
      <div class="m-knob" style="left: {{knobLeft}}px;"></div>
      <div class="m-gear" style="background-color: {{themeBtnColor}};"></div>
      <image class="m-gearIcon" src="/common/ui/gear.png"></image>
    </div>
    <div class="view" if="{{view === 'themes'}}">
      <text class="th-title">THEME</text>
      <div class="th-row0" style="background-color: {{rowBg0}}; border-color: {{rowBc0}};"></div>
      <image class="th-thumb0" src="/common/ui/thumb-sand.png"></image>
      <text class="th-name0">SAND</text>
      <text class="th-sub0">FULL SCREEN FILL</text>
      <text class="th-mark0" if="{{cur0}}">✓</text>
      <div class="th-row1" style="background-color: {{rowBg1}}; border-color: {{rowBc1}};"></div>
      <image class="th-thumb1" src="/common/ui/thumb-booster.png"></image>
      <text class="th-name1">BOOSTER</text>
      <text class="th-sub1">NEON 36-CELL GAUGE</text>
      <text class="th-mark1" if="{{cur1}}">✓</text>
      <div class="th-row2" style="background-color: {{rowBg2}}; border-color: {{rowBc2}};"></div>
      <image class="th-thumb2" src="/common/ui/thumb-battery.png"></image>
      <text class="th-name2">BATTERY</text>
      <text class="th-sub2">DRAIN / CHARGE</text>
      <text class="th-mark2" if="{{cur2}}">✓</text>
      <div class="th-row3" style="background-color: {{rowBg3}}; border-color: {{rowBc3}};"></div>
      <image class="th-thumb3" src="/common/ui/thumb-sweep.png"></image>
      <text class="th-name3">SWEEP</text>
      <text class="th-sub3">CLOCKWISE SWEEP</text>
      <text class="th-mark3" if="{{cur3}}">✓</text>
    </div>
    <div class="view" if="{{view === 'timer'}}">
      <div class="view" if="{{timerTheme === 'booster'}}">
        <image class="gauge" src="{{gaugeSrc}}"></image>
        <image class="label" src="{{labelSrc}}"></image>
        <image class="dm dm1" src="{{m1Src}}"></image>
        <image class="dm dm2" src="{{m2Src}}"></image>
        <image class="colon" src="/common/booster/colon.png"></image>
        <image class="ds ds1" src="{{s1Src}}"></image>
        <image class="ds ds2" src="{{s2Src}}"></image>
        <div class="pause" if="{{paused}}">
          <div class="bar"></div>
          <div class="bar bar-r"></div>
        </div>
      </div>
      <div class="view" if="{{timerTheme === 'sand'}}">
        <div class="sd-sand" if="{{sandShow}}" style="top: {{sandTop}}px; height: {{sandH}}px; background-color: {{sandColor}};"></div>
        <div class="sd-level" if="{{levelShow}}" style="top: {{levelTop}}px; background-color: {{levelColor}};"></div>
        <div class="sd-tick1"></div>
        <div class="sd-tick2"></div>
        <div class="sd-tick3"></div>
        <div class="sd-tick4"></div>
        <text class="t-label">{{phaseLabel}}</text>
        <text class="t-time">{{timeText}}</text>
        <text class="t-total">{{totalText}}</text>
      </div>
      <div class="view" if="{{timerTheme === 'battery'}}">
        <div class="bt-batCap"></div>
        <div class="bt-batBody"></div>
        <div class="bt-batEmpty"></div>
        <div class="bt-batFill" if="{{batShow}}" style="top: {{batTop}}px; height: {{batH}}px; background-color: {{batColor}};"></div>
        <div class="bt-batSep1"></div>
        <div class="bt-batSep2"></div>
        <div class="bt-batSep3"></div>
        <div class="bt-batSep4"></div>
        <div class="bt-pill" style="background-color: {{batColor}};"></div>
        <text class="bt-pillTxt">{{phaseLabel}}</text>
        <text class="bt-mm">{{mmText}}</text>
        <text class="bt-ss">{{ssText}}</text>
        <text class="bt-pct" style="color: {{batColor}};">{{pctText}}</text>
      </div>
      <div class="view" if="{{timerTheme === 'sweep'}}">
        <div class="w-secA" if="{{secAShow}}" style="background-color: {{secAColor}};"></div>
        <div class="w-mask" if="{{maskShow}}" style="{{maskStyle}}"></div>
        <div class="w-secB" if="{{secBShow}}" style="{{secBStyle}}"></div>
        <div class="w-edge" if="{{edgeShow}}" style="{{edgeStyle}}"></div>
        <image class="w-frame" if="{{frameShow}}" src="{{frameSrc}}"></image>
        <div class="w-tick0"></div>
        <div class="w-tick1"></div>
        <div class="w-tick2"></div>
        <div class="w-tick3"></div>
        <div class="w-tick4"></div>
        <div class="w-tick5"></div>
        <div class="w-tick6"></div>
        <div class="w-tick7"></div>
        <div class="w-tick8"></div>
        <div class="w-tick9"></div>
        <div class="w-tick10"></div>
        <div class="w-tick11"></div>
        <text class="t-label">{{phaseLabel}}</text>
        <text class="t-time">{{timeText}}</text>
        <text class="t-total">{{totalText}}</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * BOOST(뽀모도로) 0.1.9 (REDMI Watch 6 글로벌 · 432x514).
 * 한 페이지 안에 독립 뷰 세 개: view === 'setup'(설정) / 'themes'(테마 고르기) / 'timer'(타이머).
 * 별도 페이지(router) 대신 한 페이지로 둔 이유:
 *  - "백그라운드에서 돌아오면 항상 설정부터"를 onShow 하나로 처리한다. 페이지를 나누면
 *    설정 → 타이머(또는 테마 고르기) → (router.back) 때도 onShow 가 불려 복귀와 구분이 안 된다.
 *  - 페이지 스택이 없어 시스템 뒤로(오른쪽 스와이프)가 숨은 페이지로 가는 경우가 없다.
 *  - router 를 쓰지 않으면 manifest·권한이 그대로다.
 * 설정(TWIN TUBES, 모든 테마 공통): 세로 관 두 개(집중 12칸 5~60분, 휴식 30칸 1~30분)를 짚거나 위아래로 끌면
 *       그 높이 칸 값으로 바뀐다. 조작은 전부 세로이고 가로 제스처는 없다. REPEAT 탭=반복 토글, START 탭=시작,
 *       왼쪽 아래 톱니 탭=테마 고르기. 터치 판정은 timer.js setupTouchStart/Move/End(순수 함수, touch-zones.json 기준).
 * 테마 고르기: SAND·BOOSTER·BATTERY·SWEEP 줄 하나를 탭하면 저장(pomodoro.settings.v1 의 theme)하고 설정으로.
 *       시스템 뒤로도 설정으로 돌아간다(앱을 닫지 않음).
 * 시작: 설정 뷰를 닫고 게이지(테마별)를 0 → 가득으로 약 0.9초 채운 뒤 카운트다운 시작.
 * 타이머: 탭=일시정지/재개, 길게 누르기=중지 후 설정으로.
 * 초기화: onInit/onShow/onHide 에서 항상 설정 뷰, 진행 중 타이머는 버린다(설정값만 저장).
 * 소리·audio·muted·볼륨 API는 쓰지 않는다.
 */
import vibrator from '@system.vibrator'
import { loadSettings, saveSettings } from '../../common/persist.js'
import {
  TICK_MS,
  LONGPRESS_MS,
  VIBRATE_OFFSETS_MS,
  TAP_MAX_MOVE,
  INTRO_MS,
  INTRO_FRAME_MS,
  VIEW_KEYS,
  defaultSettings,
  normalizeSettings,
  setTheme,
  setupTouchStart,
  setupTouchMove,
  setupTouchEnd,
  setupGestureUi,
  shouldSwallowBack,
  setupViewModel,
  themeHit,
  themeTap,
  themesViewModel,
  armedState,
  start,
  toggle,
  advance,
  introProgress,
  viewModel
} from '../../common/timer.js'

const SETUP_KEYS = ['focusNum', 'restNum', 'focusFillH', 'focusFillTop', 'restFillH', 'restFillTop', 'repLabColor', 'togColor', 'knobLeft']
const GESTURE_KEYS = ['fActive', 'rActive', 'startColor', 'themeBtnColor']
const THEMES_KEYS = ['cur0', 'cur1', 'cur2', 'cur3', 'rowBg0', 'rowBg1', 'rowBg2', 'rowBg3', 'rowBc0', 'rowBc1', 'rowBc2', 'rowBc3']

export default {
  private: {
    view: 'setup',
    focusNum: '25',
    restNum: '05',
    focusFillH: 147,
    focusFillTop: 273,
    restFillH: 59,
    restFillTop: 361,
    repLabColor: '#FFFFFF',
    togColor: '#3DDC84',
    knobLeft: 343,
    fActive: false,
    rActive: false,
    startColor: '#FF4B4B',
    themeBtnColor: '#262626',
    cur0: true,
    cur1: false,
    cur2: false,
    cur3: false,
    rowBg0: '#1A1A1A',
    rowBg1: '#1A1A1A',
    rowBg2: '#1A1A1A',
    rowBg3: '#1A1A1A',
    rowBc0: '#FFFFFF',
    rowBc1: '#1A1A1A',
    rowBc2: '#1A1A1A',
    rowBc3: '#1A1A1A',
    timerTheme: 'sand',
    timeText: '25:00',
    phaseLabel: 'FOCUS',
    totalText: '25 MIN',
    paused: false,
    gaugeSrc: '/common/booster/g36.png',
    labelSrc: '/common/booster/focus.png',
    m1Src: '/common/booster/m2.png',
    m2Src: '/common/booster/m5.png',
    s1Src: '/common/booster/s0.png',
    s2Src: '/common/booster/s0.png',
    sandShow: true,
    sandTop: 0,
    sandH: 514,
    sandColor: '#FF4B4B',
    levelShow: false,
    levelTop: 0,
    levelColor: '#FFC9C0',
    batShow: true,
    batTop: 107,
    batH: 342,
    batColor: '#FF5A4A',
    mmText: '25',
    ssText: ':00',
    pctText: '100% LEFT',
    secAShow: true,
    maskShow: false,
    secBShow: true,
    edgeShow: false,
    secAColor: '#FF4B4B',
    maskStyle: { transform: '{"rotate":"0deg"}', transformOrigin: '0px 338px' },
    secBStyle: { transform: '{"rotate":"180deg"}', transformOrigin: '0px 338px', backgroundColor: '#FF4B4B' },
    edgeStyle: { transform: '{"rotate":"0deg"}', transformOrigin: '2px 338px', backgroundColor: '#FFC9C0' },
    frameShow: false,
    frameSrc: '/common/sweep/f60.png'
  },

  onInit() {
    this._settings = defaultSettings()
    this._state = null
    this._tickTimer = null
    this._introTimer = null
    this._introAt = 0
    this._lpTimer = null
    this._vibTimers = []
    this._touchActive = false
    this._longPressed = false
    this._touchX = 0
    this._touchY = 0
    this._gesture = null
    this._touchZone = null
    this._lastSetupTouchAt = 0
    this._settingsTouched = false
    this.goSetup(false)
  },

  onShow() {
    // 첫 실행이든 백그라운드에서 돌아온 것이든 항상 설정부터. 진행 중 타이머는 버린다.
    this.goSetup(false)
    this._settingsTouched = false
    const self = this
    loadSettings().then(function (s) {
      if (self._settingsTouched || self.view !== 'setup') return
      self._settings = normalizeSettings(s)
      self.applySetup()
    })
  },

  onHide() {
    this.goSetup(false)
    saveSettings(this._settings)
  },

  onDestroy() {
    this.stopAll(false)
  },

  onBackPress() {
    // 시스템 뒤로 = 오른쪽 스와이프.
    // 테마 고르기 화면: 앱을 닫지 않고 설정으로 돌아간다.
    if (this.view === 'themes') {
      this._touchActive = false
      this.closeThemes()
      return true
    }
    // 설정 화면에서 컨트롤을 만지는 중이거나 손 뗀 직후(BACK_GUARD_MS)면 앱을 닫지 않는다.
    if (shouldSwallowBack(this.view, this._touchActive, this._touchZone, this._lastSetupTouchAt, Date.now())) {
      return true
    }
    return false
  },

  /* ---------- 화면 전환 ---------- */

  stopAll(keepVibe) {
    this.stopTick()
    this.stopIntro()
    this.clearLpTimer()
    if (!keepVibe) this.clearVibrateTimers()
    this.setKeepScreen(false)
  },

  goSetup(keepVibe) {
    this.stopAll(keepVibe)
    this._state = null
    this._gesture = null
    this.paused = false
    this.applySetup()
    this.applyGestureUi(null)
    this.view = 'setup'
  },

  setKeys(keys, v) {
    // 바뀐 값만 넣는다(바인딩 재평가·image src 재로딩을 줄임).
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      if (this[k] !== v[k]) this[k] = v[k]
    }
  },

  applySetup() {
    this.setKeys(SETUP_KEYS, setupViewModel(this._settings))
  },

  applyGestureUi(gesture) {
    this.setKeys(GESTURE_KEYS, setupGestureUi(gesture))
  },

  applyThemes(pressed) {
    this.setKeys(THEMES_KEYS, themesViewModel(this._settings, pressed))
  },

  /** 톱니: 같은 페이지 안의 테마 고르기 뷰를 연다(별도 페이지 아님). */
  openThemes() {
    this._gesture = null
    this._touchZone = null
    this.applyGestureUi(null)
    this.applyThemes(null)
    this.view = 'themes'
  },

  closeThemes() {
    this.applyThemes(null)
    this.applySetup()
    this.applyGestureUi(null)
    this.view = 'setup'
  },

  changeSettings(next) {
    this._settings = next
    this._settingsTouched = true
    this.applySetup()
  },

  /** START: 설정 뷰 닫기 → 게이지를 0 에서 가득까지 채우는 시작 애니메이션 → 카운트다운. */
  beginSession() {
    saveSettings(this._settings)
    this.stopAll(false)
    this._state = armedState(this._settings)
    this.timerTheme = this._settings.theme
    this.applyTimer(0)
    this.view = 'timer'
    this.setKeepScreen(true)
    this._introAt = Date.now()
    const self = this
    this._introTimer = setInterval(function () {
      self.onIntroFrame()
    }, INTRO_FRAME_MS)
  },

  onIntroFrame() {
    const elapsed = Date.now() - this._introAt
    if (elapsed < INTRO_MS) {
      this.applyTimer(introProgress(elapsed))
      return
    }
    this.stopIntro()
    this._state = start(this._state, Date.now())
    this.applyTimer()
    this.startTick()
  },

  stopIntro() {
    if (this._introTimer) {
      clearInterval(this._introTimer)
      this._introTimer = null
    }
  },

  /** intro: 시작 애니메이션 진행 0..1(없으면 남은 시간 기준). 현재 테마의 바인딩만 바꾼다. */
  applyTimer(intro) {
    if (!this._state) return
    const v = viewModel(this._state, this.timerTheme, intro)
    this.setKeys(VIEW_KEYS.common, v)
    this.setKeys(VIEW_KEYS[v.theme], v)
  },

  /* ---------- 타이머 ---------- */

  startTick() {
    this.stopTick()
    const self = this
    this._tickTimer = setInterval(function () {
      self.onTick()
    }, TICK_MS)
  },

  stopTick() {
    if (this._tickTimer) {
      clearInterval(this._tickTimer)
      this._tickTimer = null
    }
  },

  onTick() {
    if (!this._state) return
    const result = advance(this._state, Date.now())
    this._state = result.state
    if (result.crossed > 0) this.pulseVibrate()
    if (result.finished) {
      // 반복 끔: 집중+휴식 한 번이 끝나면 진동 후 설정으로
      this.goSetup(true)
      return
    }
    this.applyTimer()
  },

  onToggle() {
    if (!this._state || this._introTimer) return
    this._state = toggle(this._state, Date.now())
    this.applyTimer()
    if (this._state.running) {
      this.startTick()
      this.setKeepScreen(true)
    } else {
      this.stopTick()
      this.setKeepScreen(false)
    }
  },

  setKeepScreen(on) {
    // import 시점 실패를 피하려고 호출할 때만 require 한다. API가 없어도 앱은 죽지 않는다.
    try {
      const brightness = require('@system.brightness')
      if (!brightness || typeof brightness.setKeepScreenOn !== 'function') return
      brightness.setKeepScreenOn({
        keepScreenOn: !!on,
        fail: function () {}
      })
    } catch (e) {}
  },

  pulseVibrate() {
    this.clearVibrateTimers()
    const self = this
    for (let i = 0; i < VIBRATE_OFFSETS_MS.length; i++) {
      const delay = VIBRATE_OFFSETS_MS[i]
      const timer = setTimeout(function () {
        self.safeVibrate()
      }, delay)
      this._vibTimers.push(timer)
    }
  },

  safeVibrate() {
    try {
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {}
  },

  clearVibrateTimers() {
    if (this._vibTimers && this._vibTimers.length) {
      for (let i = 0; i < this._vibTimers.length; i++) {
        clearTimeout(this._vibTimers[i])
      }
    }
    this._vibTimers = []
  },

  clearLpTimer() {
    if (this._lpTimer) {
      clearTimeout(this._lpTimer)
      this._lpTimer = null
    }
  },

  /* ---------- 터치 ---------- */

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    this._touchActive = true
    this._longPressed = false
    this._touchX = p ? p.x : 0
    this._touchY = p ? p.y : 0
    this.clearLpTimer()
    if (this.view === 'setup') {
      const g = setupTouchStart(this._settings, this._touchX, this._touchY)
      this._gesture = g
      this._touchZone = g.zone
      if (g.settings !== g.base) this.changeSettings(g.settings) // 관: 닿는 즉시 스냅
      this.applyGestureUi(g)
      return
    }
    if (this.view === 'themes') {
      this.applyThemes(p ? themeHit(p.x, p.y) : null)
      return
    }
    // 타이머: 길게 누르면 중지하고 설정으로(시작 애니메이션 중에도)
    const self = this
    this._lpTimer = setTimeout(function () {
      self._lpTimer = null
      if (!self._touchActive) return
      self._longPressed = true
      self._touchActive = false
      self.goSetup(false)
    }, LONGPRESS_MS)
  },

  onTouchMove(e) {
    if (!this._touchActive || this._longPressed) return
    const p = this.touchPoint(e)
    if (!p) return
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    const moved = dx * dx + dy * dy > TAP_MAX_MOVE * TAP_MAX_MOVE
    if (this.view === 'setup') {
      if (!this._gesture) return
      const prev = this._gesture.settings
      const g = setupTouchMove(this._gesture, p.x, p.y)
      this._gesture = g
      if (g.settings !== prev) this.changeSettings(g.settings)
      this.applyGestureUi(g)
      return
    }
    if (this.view === 'themes') {
      if (moved) this.applyThemes(null)
      return
    }
    if (moved) this.clearLpTimer()
  },

  onTouchEnd(e) {
    this.clearLpTimer()
    if (!this._touchActive) return
    this._touchActive = false
    if (this._longPressed) return
    const p = this.touchPoint(e)
    if (this.view === 'setup') {
      this._lastSetupTouchAt = Date.now()
      const g = this._gesture
      this._gesture = null
      if (!g) return
      const r = setupTouchEnd(g, p ? p.x : null, p ? p.y : null)
      if (r.settings !== this._settings) this.changeSettings(r.settings)
      this.applyGestureUi(null)
      if (r.changed) saveSettings(this._settings) // 저장은 손 뗄 때 한 번
      if (r.action === 'start') this.beginSession()
      else if (r.action === 'themes') this.openThemes()
      return
    }
    if (this.view === 'themes') {
      const id = themeTap(this._touchX, this._touchY, p ? p.x : null, p ? p.y : null)
      if (!id) {
        this.applyThemes(null)
        return
      }
      this.changeSettings(setTheme(this._settings, id))
      saveSettings(this._settings)
      this.closeThemes()
      return
    }
    const dx = p ? p.x - this._touchX : 0
    const dy = p ? p.y - this._touchY : 0
    if (dx * dx + dy * dy <= TAP_MAX_MOVE * TAP_MAX_MOVE) this.onToggle()
  },

  onTouchCancel() {
    this.clearLpTimer()
    if (this.view === 'setup' && this._touchActive) {
      // 시스템이 터치를 가져가도(당기기 등) 그때까지 관으로 바꾼 값은 남기고 저장한다(탭·START 는 실행하지 않음).
      this._lastSetupTouchAt = Date.now()
      const g = this._gesture
      this._gesture = null
      if (g && g.settings !== g.base) saveSettings(this._settings)
      this.applyGestureUi(null)
    }
    if (this.view === 'themes') this.applyThemes(null)
    this._touchActive = false
  }
}
</script>

