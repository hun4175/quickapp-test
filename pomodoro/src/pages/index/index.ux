  height: 55px;
}
.st-rdn {
  position: absolute;
  left: 165px;
  top: 298px;
  width: 63px;
  height: 56px;
}
.st-fhot {
  position: absolute;
  left: 28px;
  top: 70px;
  width: 199px;
  height: 57px;
}
.st-rhot {
  position: absolute;
  left: 28px;
