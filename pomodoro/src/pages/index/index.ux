<template>
  <div
    class="page"
    ontouchstart="onTouchStart"
    ontouchmove="onTouchMove"
    ontouchend="onTouchEnd"
    ontouchcancel="onTouchCancel"
  >
    <div class="view" if="{{view === 'setup'}}">
      <image class="st-bg" src="/common/setup/bg.png"></image>
      <image class="st-fbar0" if="{{fBar0Show}}" src="{{fBar0Src}}"></image>
      <image class="st-fbar1" if="{{fBar1Show}}" src="{{fBar1Src}}"></image>
      <image class="st-rbar0" if="{{rBar0Show}}" src="{{rBar0Src}}"></image>
      <image class="st-rbar1" if="{{rBar1Show}}" src="{{rBar1Src}}"></image>
      <image class="st-rbar2" if="{{rBar2Show}}" src="{{rBar2Src}}"></image>
      <image class="st-f1" src="{{f1Src}}"></image>
      <image class="st-f2" src="{{f2Src}}"></image>
      <image class="st-r1" src="{{r1Src}}"></image>
      <image class="st-r2" src="{{r2Src}}"></image>
      <image class="st-fupoff" if="{{fUpOffShow}}" src="/common/setup/fUp-off.png"></image>
      <image class="st-fdnoff" if="{{fDnOffShow}}" src="/common/setup/fDn-off.png"></image>
      <image class="st-rupoff" if="{{rUpOffShow}}" src="/common/setup/rUp-off.png"></image>
      <image class="st-rdnoff" if="{{rDnOffShow}}" src="/common/setup/rDn-off.png"></image>
      <image class="st-fup" if="{{fUpOn}}" src="/common/setup/fUp-on.png"></image>
      <image class="st-fdn" if="{{fDnOn}}" src="/common/setup/fDn-on.png"></image>
      <image class="st-rup" if="{{rUpOn}}" src="/common/setup/rUp-on.png"></image>
      <image class="st-rdn" if="{{rDnOn}}" src="/common/setup/rDn-on.png"></image>
      <image class="st-fhot" if="{{fHot}}" src="/common/setup/fHot.png"></image>
      <image class="st-rhot" if="{{rHot}}" src="/common/setup/rHot.png"></image>
      <image class="st-tog" src="{{toggleSrc}}"></image>
      <image class="st-start" if="{{startOn}}" src="/common/setup/start-on.png"></image>
    </div>
    <div class="view" if="{{view === 'timer'}}">
      <image class="gauge" src="{{gaugeSrc}}"></image>
      <image class="label" src="{{labelSrc}}"></image>
      <image class="dm dm1" src="{{m1Src}}"></image>
      <image class="dm dm2" src="{{m2Src}}"></image>
      <image class="colon" src="/common/booster/colon.png"></image>
      <image class="ds ds1" src="{{s1Src}}"></image>
      <image class="ds ds2" src="{{s2Src}}"></image>
      <div class="pause" if="{{paused}}">
        <div class="bar"></div>
        <div class="bar bar-r"></div>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 뽀모도로 0.1.7 (REDMI Watch 6 글로벌 · 432x514).
 * 한 페이지 안에 독립 뷰 두 개: view === 'setup'(설정) / 'timer'(부스터 계기판).
 * 별도 페이지(router) 대신 한 페이지로 둔 이유:
 *  - "백그라운드에서 돌아오면 항상 설정부터"를 onShow 하나로 처리한다. 페이지를 나누면
 *    설정 → 타이머 → (router.back) 때도 onShow 가 불려 복귀와 구분이 안 된다.
 *  - 페이지 스택이 없어 시스템 뒤로(오른쪽 스와이프)가 숨은 타이머 페이지로 가는 경우가 없다.
 *  - router 를 쓰지 않으면 manifest·권한이 그대로다.
 * 설정(THERMO): 오른쪽 세로 막대 두 개(집중 12칸 5~60분, 휴식 30칸 1~30분)를 짚거나 위아래로 끌면
 *       그 높이 칸 값으로 바뀐다. 왼쪽 큰 숫자 칸 윗절반 탭=+1단계, 아랫절반=-1단계(세로 쓸기도 36px마다 1단계).
 *       조작은 전부 세로이고 가로 제스처는 없다. REPEAT 탭=반복 토글, START 탭=시작.
 *       터치 판정은 timer.js setupTouchStart/Move/End(순수 함수, touch-zones.json 기준).
 * 시작: 설정 뷰를 닫고 게이지를 0칸→36칸으로 약 0.9초 채운 뒤 카운트다운 시작.
 * 타이머: 탭=일시정지/재개, 길게 누르기=중지 후 설정으로.
 * 초기화: onInit/onShow 에서 항상 설정 뷰, 진행 중 타이머는 버린다(설정값만 저장).
 * 소리·audio·muted·볼륨 API는 쓰지 않는다.
 */
import vibrator from '@system.vibrator'
import { loadSettings, saveSettings } from '../../common/persist.js'
import {
  TICK_MS,
  LONGPRESS_MS,
  VIBRATE_OFFSETS_MS,
  TAP_MAX_MOVE,
  PRESS_FLASH_MS,
  INTRO_MS,
  INTRO_FRAME_MS,
  defaultSettings,
  normalizeSettings,
  setupTouchStart,
  setupTouchMove,
  setupTouchEnd,
  setupGestureUi,
  shouldSwallowBack,
  setupViewModel,
  armedState,
  start,
  toggle,
  advance,
  introLit,
  viewModel
} from '../../common/timer.js'

export default {
  private: {
    view: 'setup',
    f1Src: '/common/setup/f2.png',
    f2Src: '/common/setup/f5.png',
    r1Src: '/common/setup/r0.png',
    r2Src: '/common/setup/r5.png',
    fBar0Show: true,
    fBar0Src: '/common/setup/fg05m.png',
    fBar1Show: false,
    fBar1Src: '/common/setup/fg06.png',
    rBar0Show: true,
    rBar0Src: '/common/setup/rg05m.png',
    rBar1Show: false,
    rBar1Src: '/common/setup/rg10.png',
    rBar2Show: false,
    rBar2Src: '/common/setup/rg10.png',
    fUpOffShow: false,
    fDnOffShow: false,
    rUpOffShow: false,
    rDnOffShow: false,
    fUpOn: false,
    fDnOn: false,
    rUpOn: false,
    rDnOn: false,
    fHot: false,
    rHot: false,
    startOn: false,
    toggleSrc: '/common/setup/tog-on.png',
    gaugeSrc: '/common/booster/g36.png',
    labelSrc: '/common/booster/focus.png',
    m1Src: '/common/booster/m2.png',
    m2Src: '/common/booster/m5.png',
    s1Src: '/common/booster/s0.png',
    s2Src: '/common/booster/s0.png',
    paused: false
  },

  onInit() {
    this._settings = defaultSettings()
    this._state = null
    this._tickTimer = null
    this._introTimer = null
    this._introAt = 0
    this._lpTimer = null
    this._vibTimers = []
    this._touchActive = false
    this._longPressed = false
    this._touchX = 0
    this._touchY = 0
    this._gesture = null
    this._touchZone = null
    this._lastSetupTouchAt = 0
    this._flashTimer = null
    this._settingsTouched = false
    this.goSetup(false)
  },

  onShow() {
    // 첫 실행이든 백그라운드에서 돌아온 것이든 항상 설정부터. 진행 중 타이머는 버린다.
    this.goSetup(false)
    this._settingsTouched = false
    const self = this
    loadSettings().then(function (s) {
      if (self._settingsTouched || self.view !== 'setup') return
      self._settings = normalizeSettings(s)
      self.applySetup()
    })
  },

  onHide() {
    this.goSetup(false)
    saveSettings(this._settings)
  },

  onDestroy() {
    this.stopAll(false)
  },

  onBackPress() {
    // 시스템 뒤로 = 오른쪽 스와이프. 설정 화면에서 컨트롤을 만지는 중이거나 손 뗀 직후(BACK_GUARD_MS)면
    // 앱을 닫지 않는다. 세로 끌기가 오른쪽으로 비껴도 값만 바뀐다.
    if (shouldSwallowBack(this.view, this._touchActive, this._touchZone, this._lastSetupTouchAt, Date.now())) {
      return true
    }
    return false
  },

  /* ---------- 화면 전환 ---------- */

  stopAll(keepVibe) {
    this.stopTick()
    this.stopIntro()
    this.clearLpTimer()
    this.clearFlash()
    if (!keepVibe) this.clearVibrateTimers()
    this.setKeepScreen(false)
  },

  goSetup(keepVibe) {
    this.stopAll(keepVibe)
    this._state = null
    this._gesture = null
    this.paused = false
    this.applySetup()
    this.applyGestureUi(null)
    this.view = 'setup'
  },

  applySetup() {
    const v = setupViewModel(this._settings)
    const keys = [
      'f1Src', 'f2Src', 'r1Src', 'r2Src',
      'fBar0Show', 'fBar0Src', 'fBar1Show', 'fBar1Src',
      'rBar0Show', 'rBar0Src', 'rBar1Show', 'rBar1Src', 'rBar2Show', 'rBar2Src',
      'fUpOffShow', 'fDnOffShow', 'rUpOffShow', 'rDnOffShow',
      'toggleSrc'
    ]
    // 바뀐 값만 넣어 image src 재로딩을 줄인다(막대 끌기 때 보통 묶음 1개 + 숫자 1~2개만 바뀜).
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      if (this[k] !== v[k]) this[k] = v[k]
    }
  },

  applyGestureUi(gesture) {
    const u = setupGestureUi(gesture)
    const keys = ['fHot', 'rHot', 'fUpOn', 'fDnOn', 'rUpOn', 'rDnOn', 'startOn']
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      if (this[k] !== u[k]) this[k] = u[k]
    }
  },

  clearFlash() {
    if (this._flashTimer) {
      clearTimeout(this._flashTimer)
      this._flashTimer = null
    }
  },

  /** 숫자 칸 탭: ▲▼ 눌림과 밑줄 강조를 손 뗀 뒤 PRESS_FLASH_MS 더 보여 준다. */
  flashPressed(flash) {
    this.clearFlash()
    const u = setupGestureUi(null)
    u[flash + 'On'] = true
    u[flash.charAt(0) + 'Hot'] = true
    const keys = ['fHot', 'rHot', 'fUpOn', 'fDnOn', 'rUpOn', 'rDnOn', 'startOn']
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]
      if (this[k] !== u[k]) this[k] = u[k]
    }
    const self = this
    this._flashTimer = setTimeout(function () {
      self._flashTimer = null
      self.applyGestureUi(null)
    }, PRESS_FLASH_MS)
  },

  changeSettings(next) {
    this._settings = next
    this._settingsTouched = true
    this.applySetup()
  },

  /** START: 설정 뷰 닫기 → 게이지 0칸에서 36칸까지 채우는 시작 애니메이션 → 카운트다운. */
  beginSession() {
    saveSettings(this._settings)
    this.stopAll(false)
    this._state = armedState(this._settings)
    this.applyTimer(0)
    this.view = 'timer'
    this.setKeepScreen(true)
    this._introAt = Date.now()
    const self = this
    this._introTimer = setInterval(function () {
      self.onIntroFrame()
    }, INTRO_FRAME_MS)
  },

  onIntroFrame() {
    const elapsed = Date.now() - this._introAt
    if (elapsed < INTRO_MS) {
      this.applyTimer(introLit(elapsed))
      return
    }
    this.stopIntro()
    this._state = start(this._state, Date.now())
    this.applyTimer()
    this.startTick()
  },

  stopIntro() {
    if (this._introTimer) {
      clearInterval(this._introTimer)
      this._introTimer = null
    }
  },

  applyTimer(litOverride) {
    if (!this._state) return
    const v = viewModel(this._state, litOverride)
    // 바뀐 값만 넣어 image src 재로딩을 줄인다.
    if (this.gaugeSrc !== v.gaugeSrc) this.gaugeSrc = v.gaugeSrc
    if (this.labelSrc !== v.labelSrc) this.labelSrc = v.labelSrc
    if (this.m1Src !== v.m1Src) this.m1Src = v.m1Src
    if (this.m2Src !== v.m2Src) this.m2Src = v.m2Src
    if (this.s1Src !== v.s1Src) this.s1Src = v.s1Src
    if (this.s2Src !== v.s2Src) this.s2Src = v.s2Src
    if (this.paused !== v.paused) this.paused = v.paused
  },

  /* ---------- 타이머 ---------- */

  startTick() {
    this.stopTick()
    const self = this
    this._tickTimer = setInterval(function () {
      self.onTick()
    }, TICK_MS)
  },

  stopTick() {
    if (this._tickTimer) {
      clearInterval(this._tickTimer)
      this._tickTimer = null
    }
  },

  onTick() {
    if (!this._state) return
    const result = advance(this._state, Date.now())
    this._state = result.state
    if (result.crossed > 0) this.pulseVibrate()
    if (result.finished) {
      // 반복 끔: 집중+휴식 한 번이 끝나면 진동 후 설정으로
      this.goSetup(true)
      return
    }
    this.applyTimer()
  },

  onToggle() {
    if (!this._state || this._introTimer) return
    this._state = toggle(this._state, Date.now())
    this.applyTimer()
    if (this._state.running) {
      this.startTick()
      this.setKeepScreen(true)
    } else {
      this.stopTick()
      this.setKeepScreen(false)
    }
  },

  setKeepScreen(on) {
    // import 시점 실패를 피하려고 호출할 때만 require 한다. API가 없어도 앱은 죽지 않는다.
    try {
      const brightness = require('@system.brightness')
      if (!brightness || typeof brightness.setKeepScreenOn !== 'function') return
      brightness.setKeepScreenOn({
        keepScreenOn: !!on,
        fail: function () {}
      })
    } catch (e) {}
  },

  pulseVibrate() {
    this.clearVibrateTimers()
    const self = this
    for (let i = 0; i < VIBRATE_OFFSETS_MS.length; i++) {
      const delay = VIBRATE_OFFSETS_MS[i]
      const timer = setTimeout(function () {
        self.safeVibrate()
      }, delay)
      this._vibTimers.push(timer)
    }
  },

  safeVibrate() {
    try {
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {}
  },

  clearVibrateTimers() {
    if (this._vibTimers && this._vibTimers.length) {
      for (let i = 0; i < this._vibTimers.length; i++) {
        clearTimeout(this._vibTimers[i])
      }
    }
    this._vibTimers = []
  },

  clearLpTimer() {
    if (this._lpTimer) {
      clearTimeout(this._lpTimer)
      this._lpTimer = null
    }
  },

  /* ---------- 터치 ---------- */

  touchPoint(e) {
    const list =
      (e && e.changedTouches && e.changedTouches.length && e.changedTouches) ||
      (e && e.touches && e.touches.length && e.touches) ||
      null
    if (!list || !list[0]) return null
    const t = list[0]
    const x = t.clientX != null ? t.clientX : t.pageX
    const y = t.clientY != null ? t.clientY : t.pageY
    if (x == null || y == null) return null
    return { x: Number(x), y: Number(y) }
  },

  onTouchStart(e) {
    const p = this.touchPoint(e)
    this._touchActive = true
    this._longPressed = false
    this._touchX = p ? p.x : 0
    this._touchY = p ? p.y : 0
    this.clearLpTimer()
    if (this.view === 'setup') {
      this.clearFlash()
      const g = setupTouchStart(this._settings, this._touchX, this._touchY)
      this._gesture = g
      this._touchZone = g.zone
      if (g.settings !== g.base) this.changeSettings(g.settings) // 막대: 닿는 즉시 스냅
      this.applyGestureUi(g)
      return
    }
    // 타이머: 길게 누르면 중지하고 설정으로(시작 애니메이션 중에도)
    const self = this
    this._lpTimer = setTimeout(function () {
      self._lpTimer = null
      if (!self._touchActive) return
      self._longPressed = true
      self._touchActive = false
      self.goSetup(false)
    }, LONGPRESS_MS)
  },

  onTouchMove(e) {
    if (!this._touchActive || this._longPressed) return
    const p = this.touchPoint(e)
    if (!p) return
    if (this.view === 'setup') {
      if (!this._gesture) return
      const prev = this._gesture.settings
      const g = setupTouchMove(this._gesture, p.x, p.y)
      this._gesture = g
      if (g.settings !== prev) this.changeSettings(g.settings)
      this.applyGestureUi(g)
      return
    }
    const dx = p.x - this._touchX
    const dy = p.y - this._touchY
    if (dx * dx + dy * dy > TAP_MAX_MOVE * TAP_MAX_MOVE) this.clearLpTimer()
  },

  onTouchEnd(e) {
    this.clearLpTimer()
    if (!this._touchActive) return
    this._touchActive = false
    if (this._longPressed) return
    const p = this.touchPoint(e)
    if (this.view === 'setup') {
      this._lastSetupTouchAt = Date.now()
      const g = this._gesture
      this._gesture = null
      if (!g) return
      const r = setupTouchEnd(g, p ? p.x : null, p ? p.y : null)
      if (r.settings !== this._settings) this.changeSettings(r.settings)
      if (r.flash) this.flashPressed(r.flash)
      else this.applyGestureUi(null)
      if (r.changed) saveSettings(this._settings) // 저장은 손 뗄 때 한 번
      if (r.action === 'start') this.beginSession()
      return
    }
    const dx = p ? p.x - this._touchX : 0
    const dy = p ? p.y - this._touchY : 0
    if (dx * dx + dy * dy <= TAP_MAX_MOVE * TAP_MAX_MOVE) this.onToggle()
  },

  onTouchCancel() {
    this.clearLpTimer()
    if (this.view === 'setup' && this._touchActive) {
      // 시스템이 터치를 가져가도(당기기 등) 그때까지 막대로 바꾼 값은 남기고 저장한다(탭·START 는 실행하지 않음).
      this._lastSetupTouchAt = Date.now()
      const g = this._gesture
      this._gesture = null
      if (g && g.settings !== g.base) saveSettings(this._settings)
      this.applyGestureUi(null)
    }
    this._touchActive = false
  }
}
</script>

<style>
